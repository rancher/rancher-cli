    {
      "appliesTo": "mutating",
      "desc": "preview Effect, no change",
      "name": "--dry-run",
      "type": "bool"
    },
    {
      "appliesTo": "mutating",
      "desc": "execute the mutation",
      "name": "--apply",
      "type": "bool"
    },
    {
      "appliesTo": "mutating",
      "desc": "confirm a destructive Effect",
      "name": "--yes",
      "type": "bool"
    },
    {
      "appliesTo": "mutating",
      "desc": "permit a deprecated-tier write",
      "name": "--allow-deprecated",
      "type": "bool"
    },
    {
      "appliesTo": "all",
      "desc": "never prompt; ambiguity -\u003e error",
      "name": "--no-input",
      "type": "bool"
    },
