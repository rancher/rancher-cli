env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# bare form: ordinary namespaced secret; --from-literal round-trips through
# the server's stringData->data base64 conversion.
exec rancher create namespace secret-ns --cluster testcluster --apply
exec rancher create secret app-secret --namespace secret-ns --cluster testcluster --from-literal key=v1,other=v2 --apply --yes
exec rancher get secret app-secret --cluster testcluster --namespace secret-ns -o json
jsonquery stdout data.data.key djE=
jsonquery stdout data.data.other djI=
jsonquery stdout data.type Opaque

# project-scoped with status.backingNamespace SET: no controllers run in
# this harness, so the status lever sets it directly.
exec rancher create project secret-proj --cluster testcluster --apply
exec rancher create namespace secret-proj-backing --cluster local --apply
flipstatus local management.cattle.io/v3/projects c-test secret-proj {"backingNamespace":"secret-proj-backing"}

exec rancher create secret shared-cred --project secret-proj --project-scoped --cluster testcluster --from-literal token=abc --apply --yes -o json
jsonquery stdout data.metadata.namespace secret-proj-backing
jsonquery stdout 'data.metadata.labels.management\.cattle\.io/project-scoped-secret' secret-proj

exec rancher get secrets --cluster local --namespace secret-proj-backing -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.data.token YWJj

# fallback: a second project with no status set lands in the project-id
# namespace (created here — the fallback backing namespace IS the project
# id) and carries the propagation warning (PS-8: floor is now 2.14).
exec rancher create project secret-proj-nostatus --cluster testcluster --apply
exec rancher create namespace secret-proj-nostatus --cluster local --apply
exec rancher create secret fallback-cred --project secret-proj-nostatus --project-scoped --cluster testcluster --from-literal token=xyz --apply --yes -o json
jsonquery stdout 'warnings.0' 'project-scoped secret propagation is not guaranteed (requires Rancher >= 2.14, the supported minimum)'

# VALIDATION matrix.
! exec rancher create secret bad-secret --project secret-proj --cluster testcluster --namespace secret-proj-backing --project-scoped --apply
stderr 'error \(VALIDATION\):'

! exec rancher create secret bad-secret --project-scoped --cluster testcluster --apply
stderr 'error \(VALIDATION\):'
