# config-flow: never sets RANCHER_CLI_URL/RANCHER_CLI_TOKEN — the point is to prove
# the STORED token (E2E-A-002), not an env override, drives auth.

stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin
exists $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher auth status -o json
jsonquery stdout data.ok true
jsonquery stdout data.server e2e

exec rancher auth status
stdout 'AUTH STATUS'
stdout 'ok: true'
stdout 'server: e2e'

# logout deletes the matching exec-credential cache entry alongside the login token
seedexeccache e2e-c-test c-test
exec rancher auth logout e2e -o json
jsonquery stdout 'data.deletedCache.#' 1

-- token.txt --
e2e:secret
