env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# capimachine's table GVR has an empty version; this proves discovery
# resolves it against the served cluster.x-k8s.io/v1beta1 group.
exec rancher create resource -f machine.yaml --apply

exec rancher get machines
stdout capi-machine-1

-- machine.yaml --
apiVersion: cluster.x-k8s.io/v1beta1
kind: Machine
metadata:
  name: capi-machine-1
spec: {}
