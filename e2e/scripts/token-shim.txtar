# Token shim end to end: a token derived from the stored login, warm cache
# hit, distinct cache slots, and schema binding. The shim derives its token
# from the stored login by design —
# kubeconfig exec-credential plugins run non-interactively, so the only
# viable path is to consume the session credential that `auth login` already
# stored. The different-user step succeeds (not fails) because the stored
# session credential for this server is shared across cache slots; --no-input
# is irrelevant on the success path since storedCredToken never prompts.

# Setup: store a session credential (mirrors auth-login.txtar).
stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin
exists $RANCHER_CLI_CONFIG_DIR/config.yaml

# Kubeconfig-style invocation: exactly the args Rancher's template passes.
exec rancher token --server $TEST_RANCHER_URL --user testcluster
cp stdout first.json
jsonquery first.json kind ExecCredential
jsonquery first.json apiVersion client.authentication.k8s.io/v1beta1
! jsonquery first.json status.token ''

# Second invocation is a warm cache hit: no re-authentication (no stderr).
exec rancher token --server $TEST_RANCHER_URL --user testcluster
jsonquery stdout kind ExecCredential
! jsonquery stdout status.token ''
! stderr .

# Poison config.yaml then verify the warm hit still succeeds — this is the
# end-to-end proof that resolveDeps is bypassed for the `token` entry (the
# `token` entry is marked bare: true). The unit test
# TestLegacyTokenCacheHitIgnoresBrokenConfig exercises Execute directly;
# this step is the dispatch-layer proof at the real binary level.
cp $RANCHER_CLI_CONFIG_DIR/config.yaml config.yaml.bak
cp broken-config.yaml $RANCHER_CLI_CONFIG_DIR/config.yaml
exec rancher token --server $TEST_RANCHER_URL --user testcluster
jsonquery stdout kind ExecCredential
! jsonquery stdout status.token ''
! stderr .
# Restore config.yaml for the remaining steps.
cp config.yaml.bak $RANCHER_CLI_CONFIG_DIR/config.yaml

# A different --user is a different cache slot. The stored login credential is
# shared, so even with --no-input the shim succeeds non-interactively.
# Branch taken: SUCCESS via a token derived from the stored login.
exec rancher token --server $TEST_RANCHER_URL --user othercluster --no-input
jsonquery stdout kind ExecCredential
! jsonquery stdout status.token ''

# Two distinct cache slots were written: one per --user value.
exec rancher auth list-tokens -o json
jsonquery stdout 'data.#' 2
jsonquery stdout 'data.#(name=="legacy:testcluster").name' 'legacy:testcluster'
jsonquery stdout 'data.#(name=="legacy:othercluster").name' 'legacy:othercluster'

# The manifest marks the shim internal · deprecated.
exec rancher schema token -o json
jsonquery stdout data.contract internal
jsonquery stdout data.stability deprecated

-- token.txt --
e2e:secret

-- broken-config.yaml --
	: not yaml [
