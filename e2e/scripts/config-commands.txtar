# RANCHER_CLI_CREDENTIAL_STORE=file is already Setup's default (headless CI has
# no keyring; deliberately why there is no `logout` txtar either) — pinned
# here explicitly too since delete-server deletes a real credential store.
env RANCHER_CLI_CREDENTIAL_STORE=file

# config path: prints the resolved path whether or not the file exists yet.
! exists $RANCHER_CLI_CONFIG_DIR/config.yaml
exec rancher config path
pathmatch stdout $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher config path -o json
jsonquery stdout data.exists false

# Seed a server + current-server pointer via a direct config-file write — no
# login flow needed just to populate config.yaml.
mkdir $RANCHER_CLI_CONFIG_DIR
cp seed-config.yaml $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher config path -o json
jsonquery stdout data.exists true

exec rancher config list-servers -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.name acme

# config delete-server: unknown name -> NOT_FOUND with candidates (the
# logout pattern).
! exec rancher config delete-server nope -o json
jsonquery stderr data.error.code NOT_FOUND
jsonquery stderr 'data.error.candidates.#' 1
jsonquery stderr data.error.candidates.0.id acme

# config delete-server end-to-end: removes the server, clears the
# current-server pointer that named it, and reports the delete (file
# backend; no stored token here, so deletedFrom is empty) — does NOT revoke
# the server-side token.
exec rancher config delete-server acme -o json
jsonquery stdout data.server acme
jsonquery stdout data.currentServerCleared true

exec rancher config list-servers -o json
jsonquery stdout 'data.#' 0

exec rancher config status -o json
jsonquery stdout data.currentServer ''

# config edit: the only path this harness can honestly drive without
# scripting an interactive editor is the no-TTY gate — `exec` here has no
# terminal attached.
! exec rancher config edit
stderr 'error \(VALIDATION\):'
stderr 'TTY'
pathmatch stderr $RANCHER_CLI_CONFIG_DIR/config.yaml

# config add-server: establishes trust, records the entry, and bootstraps
# the current-server pointer (empty here, after the delete-server above).
exec rancher config add-server qa1 --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT -o json
jsonquery stdout data.name qa1
jsonquery stdout data.unchanged false
jsonquery stdout data.currentServer qa1

# idempotent re-run: an identical url+ca is an entry no-op, never a second write.
exec rancher config add-server qa1 --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT -o json
jsonquery stdout data.unchanged true

# a different URL under the same name is CONFLICT, never a silent upsert —
# the machine hint is the single, fully interpolated update-server command.
! exec rancher config add-server qa1 --url https://different.example.com -o json
jsonquery stderr data.error.code CONFLICT
jsonquery stderr data.error.hint 'rancher config update-server ''qa1'' --url ''https://different.example.com'''

# config update-server --clear-cacert (system roots) and a URL change
# against a different host are exercised at the unit level
# (config_update_server_test.go, register_test.go) — this harness's single
# real server presents a self-signed cert, so clearing its CA or dialing a
# different host cannot succeed here; the e2e coverage below stays limited
# to what a real probe against the actual test server can prove.

# a same-value update (URL already effective) is a no-op success after the
# verification probe.
exec rancher config update-server qa1 --url $TEST_RANCHER_URL -o json
jsonquery stdout data.unchanged true

exec rancher config delete-server qa1 -o json

-- seed-config.yaml --
currentServer: acme
servers:
  acme:
    url: https://acme.example.com
