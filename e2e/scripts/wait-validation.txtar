env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# --for without --wait
! exec rancher get pod whatever --for state=x
stderr 'error \(VALIDATION\):'

# --wait on a list (no name)
! exec rancher get statefulset --wait --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# bare --wait on a kind with no default wait condition
! exec rancher get statefulset whatever --wait --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# --for grammar is rejected (not JSONPath, not a bare word)
! exec rancher get pod whatever --wait --for garbage --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'
