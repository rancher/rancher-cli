# Device-code login against the façade's IdP stub (spec FA-4.2): non-TTY is
# allowed here (pinned by TestOAuthDeviceCodeFlowNonTTYAllowed) — no ttyin
# needed. Login completes after the stub's pending polls; the stored
# credential is asserted by exercising it, never by string-matching the
# token itself.
exec rancher auth login --server $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider azureADProvider --auth-flow devicecode
exists $RANCHER_CLI_CONFIG_DIR/config.yaml

# Membership, not count: scripts run concurrently against one shared
# apiserver, and inspect-cluster.txtar seeds management clusters of its own.
exec rancher get clusters -o json
jsonquery stdout 'data.#(metadata.name=="c-test").metadata.name' c-test
