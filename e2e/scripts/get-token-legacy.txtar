# This script's façade instance runs in legacy mode (harness_test.go's
# legacyScripts table, keyed by this file's name) — the ext.cattle.io token create
# route 404s, so cold get-token falls back to the raw stored login token,
# cached for the bounded legacyTokenTTL (spec FA-4.4). Cache-hit assertion is
# via stderr, not a counter: the cold call emits the legacy-caching notice
# and the warm call emits nothing.
stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin
exists $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher auth delete-token --all -o json
jsonquery stdout data.deleted all

exec rancher auth get-token --server $TEST_RANCHER_URL --cluster c-test --name ex
cp stdout execcred1.json
jsonquery execcred1.json kind ExecCredential
stderr 'caching the stored login token for 15m0s'

exec rancher auth get-token --server $TEST_RANCHER_URL --cluster c-test --name ex
cp stdout execcred2.json
jsonquery execcred2.json kind ExecCredential
! stderr .

# Membership, not count: scripts run concurrently against one shared
# apiserver, and inspect-cluster.txtar seeds management clusters of its own.
exec rancher get clusters -o json
jsonquery stdout 'data.#(metadata.name=="c-test").metadata.name' c-test

-- token.txt --
e2e:secret
