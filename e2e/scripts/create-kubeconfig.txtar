env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# kubeconfig is a Sensitive kind: bare --apply is refused.
! exec rancher create kubeconfig --apply
stderr 'error \(CONFIRMATION_REQUIRED\):'

# RawBytes writes verbatim regardless of -o, so every format but the bare
# table default is refused before Plan even runs.
! exec rancher create kubeconfig --clusters testcluster -o json --apply --yes
jsonquery stderr data.error.code VALIDATION

# dry-run preview: the Effect, no kubeconfig content is ever previewed.
exec rancher create kubeconfig --clusters testcluster --dry-run
stdout 'create kubeconfig/fac-kubeconfig-2'
stdout 'dry run'

# apply: the embedded document's server URL names the resolved cluster
# (c-test, testcluster's id) — true whether entries are named by id (this
# fixture) or by display name (the real store).
exec rancher create kubeconfig --clusters testcluster --description e2e-ci --apply --yes
stdout 'ext kubeconfig "fac-kubeconfig-4" — shown exactly once; revoke with: rancher delete kubeconfig fac-kubeconfig-4'
stdout 'name: c-test'
stdout 'server: .*/k8s/clusters/c-test'

# the create also persisted a named copy to the real store (round 2 fix):
# get kubeconfig by the generated name succeeds and echoes the real spec.
exec rancher get kubeconfig fac-kubeconfig-4 -o json
jsonquery stdout data.spec.description e2e-ci

# --include-default-entry=false requires --clusters: refused before Plan.
! exec rancher create kubeconfig --include-default-entry=false --apply --yes
stderr 'error \(VALIDATION\):'
