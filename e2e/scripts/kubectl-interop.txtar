# This script sticks to the WARM exec-credential cache path via
# seedexeccache; kubectl-interop-cold.txtar covers the cold round trip
# through the façade's /v1-public/* endpoints and the ext.cattle.io/v1
# token mint instead (spec FA-0 supersedes the old "shim must not grow"
# note — the façade is a separate layer composed in front of the
# unchanged router, per docs/superpowers/specs/2026-07-11-auth-e2e-harness-design.md).
# seedexeccache pre-warms the cache through the real config store API, so
# get-token takes its cache fast-path here without touching login at all.
[!kubectl] skip 'kubectl not on PATH'

stdin token.txt
exec rancher auth login --token-stdin --server $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --name e2e --context c-test:

seedexeccache e2e-c-test c-test

exec rancher kubeconfig --cluster testcluster
cp stdout kc.yaml

exec kubectl --kubeconfig kc.yaml get namespaces
stdout default

-- token.txt --
e2e:secret
