env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# imported: spec.rkeConfig is OMITTED entirely (nil, not {}) — the pin.
exec rancher create cluster imported-1 --import --apply
# The envtest harness has no SelfUser store, so creatorId stamping degrades
# to a warning. This assertion asserts the degrade path on every create.
stderr 'creatorId not stamped'
exec rancher get provisioning-cluster imported-1 -o json
jsonquery stdout data.spec.rkeConfig ''

# custom: spec.rkeConfig is present, as an empty map, with no machine pools.
exec rancher create cluster custom-1 --custom --k8s-version v1.30.5+rke2r1 --apply
stderr 'creatorId not stamped'
exec rancher get provisioning-cluster custom-1 -o json
jsonquery stdout data.spec.rkeConfig '{}'

# node-driver: full --apply (no rancher webhook in this harness, so the
# create succeeds even though the referenced machine config object does not
# exist), resolving --cloud-credential by display name against the fixture
# seeded once globally in cattle-global-data (e2e/harness_test.go).
exec rancher create cluster node-1 --machine-config amazonec2config/mycfg --cloud-credential e2e-cred --k8s-version v1.30.5+rke2r1 --etcd --controlplane --worker --apply
stderr 'creatorId not stamped'
exec rancher get provisioning-cluster node-1 -o json
jsonquery stdout data.spec.cloudCredentialSecretName cattle-global-data:cc-e2etest
jsonquery stdout data.spec.rkeConfig.machinePools.0.machineConfigRef.kind Amazonec2Config
jsonquery stdout data.spec.rkeConfig.machinePools.0.machineConfigRef.name mycfg

# mode exclusivity and per-pool validation.
! exec rancher create cluster bad-1 --import --custom
stderr 'error \(VALIDATION\):'

! exec rancher create cluster bad-2 --import --cloud-credential e2e-cred
stderr 'error \(VALIDATION\):'

! exec rancher create cluster bad-3 --machine-config amazonec2config/mycfg --cloud-credential e2e-cred --k8s-version v1.30.5+rke2r1
stderr 'error \(VALIDATION\):'
stderr 'at least one role'

# Task 9 (spec D-6): guarded provisioning-cluster delete. The "local" guard
# runs after inner.Plan confirms the object's existence; in this hermetic
# harness there is no "local" provisioning-cluster, so the command returns
# NOT_FOUND. In production where "local" exists, inner.Plan succeeds and the
# guard refuses with VALIDATION before execute.
! exec rancher delete provisioning-cluster local --apply --yes
stderr 'error \(NOT_FOUND\):'

# dry-run previews the cascade warning without deleting imported-1 (this
# script's own imported cluster, created above).
exec rancher delete provisioning-cluster imported-1 --dry-run -o json
cp stdout delete-eff.json
jsonquery delete-eff.json warnings.0 'deleting this provisioning cluster cascades: the provisioning controller removes the linked CAPI Cluster, which takes its Machines and RKEControlPlane with it, and separately removes the corresponding management Cluster'

# the real delete, then confirm it is gone.
exec rancher delete provisioning-cluster imported-1 --apply --yes

! exec rancher get provisioning-cluster imported-1 -o json
jsonquery stderr data.error.code NOT_FOUND
