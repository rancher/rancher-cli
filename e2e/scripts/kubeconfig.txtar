# DR-007: kubeconfig must work from an env-only session too (no stored
# context) — a fresh --config dir proves it, since every other e2e case in
# this script shares RANCHER_CONFIG_DIR with the auth-login below.
mkdir envonly
env RANCHER_URL=$TEST_RANCHER_URL
env RANCHER_TOKEN=$TEST_RANCHER_TOKEN
exec rancher --config envonly kubeconfig --cluster testcluster
cp stdout kc-env.yaml
jsonquery -yaml kc-env.yaml clusters.0.cluster.server $TEST_RANCHER_URL/k8s/clusters/c-test
jsonquery -yaml kc-env.yaml users.0.user.exec.apiVersion client.authentication.k8s.io/v1beta1
env RANCHER_URL=
env RANCHER_TOKEN=

stdin token.txt
exec rancher auth login --token-stdin --server $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --name e2e

exec rancher kubeconfig --cluster testcluster
cp stdout kc.yaml
jsonquery -yaml kc.yaml clusters.0.cluster.server $TEST_RANCHER_URL/k8s/clusters/c-test
jsonquery -yaml kc.yaml users.0.user.exec.apiVersion client.authentication.k8s.io/v1beta1
jsonquery -yaml kc.yaml users.0.user.exec.command rancher
jsonquery -yaml kc.yaml users.0.user.exec.args.6 --name

-- token.txt --
e2e:secret
