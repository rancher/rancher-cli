# Hermetic and network-free by construction: shell completion never touches
# the server. Script emission is a unit-level golden concern (byte-exact) —
# this only pins the substrings a real .bashrc source relies on.
exec rancher completion bash
stdout 'generate-shell-completion'
stdout 'urfave/cli'

! exec rancher completion nope-shell
jsonquery stderr data.error.code VALIDATION

# Callback driving: --generate-shell-completion must be LAST (checkShellCompleteFlag
# looks only at the final argument). Default urfave suggestions and our
# alias-aware override both arrive as "name:usage" lines — anchor on the name
# prefix, never a whole line (urfave-owned ordering/usage text is not ours to
# pin exactly).
exec rancher get --generate-shell-completion
stdout '(?m)^pod:'
stdout '(?m)^po:'
stdout '(?m)^pods:'
stdout '(?m)^management-token:'
stdout '(?m)^v3token:'
stdout '(?m)^v3tokens:'

# Seed a context via a direct config-file write (config-commands.txtar's
# precedent) — no login flow needed just to populate config.yaml. The
# config-local ShellCompleter path prints one BARE candidate per line (no
# ":usage" suffix), so this anchors on the whole line.
mkdir $RANCHER_CLI_CONFIG_DIR
cp seed-config.yaml $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher config use-context --generate-shell-completion
stdout '(?m)^acme$'

# AC-29/AC-31: config set-completion appears in completion output.
exec rancher config --generate-shell-completion
stdout '(?m)^set-completion:'

# AC-28: equals-form site — --by=n emits ALL four --by=<candidate> full tokens.
# The binary emits all enum candidates; the shell prefix-filters them (AC-21a).
# Assert all four values appear (round-2 finding 15: the enum emits all four, not
# just those matching the typed prefix).
# v2 protocol: equals-form current word in --rancher-completion-cur= field; argv
# does NOT include the partial token (the field IS the current word, not an argv token).
exec rancher --rancher-completion-proto=2 usage --rancher-completion-cur=--by=n --generate-shell-completion
stdout '(?m)^--by=namespace$'
stdout '(?m)^--by=node$'
stdout '(?m)^--by=project$'
stdout '(?m)^--by=pod$'

# AC-15a: inspect alias suggestion — po and deploy appear in inspect group.
exec rancher inspect --generate-shell-completion
stdout '(?m)^po:'
stdout '(?m)^deploy:'

# AC-15a: inspect alias invocation — binary dispatches via alias, not "unknown command".
# Restore seed config (directory already exists from line 25; no mkdir needed).
cp seed-config.yaml $RANCHER_CLI_CONFIG_DIR/config.yaml
! exec rancher inspect po --namespace default missing-pod
! stderr 'unknown command'

# AC-30: opt-in off → leaf completion returns nothing.
# get pod is already at the leaf; positional completion without live network
# yields no candidates. pod: is a subcommand suggestion from the group level,
# not what a leaf callback emits (round-2 finding 10 fix).
exec rancher get pod --generate-shell-completion
! stdout '(?m)^mypod$'
! stdout '(?m)^pod:'

# Enable live completion and point at the per-script facade for remaining AC-30 tests.
exec rancher config set-completion --network=true
env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_CACERT=$TEST_RANCHER_CACERT

# AC-30: exec-cred-only + display-name cluster → cluster flag-value site returns empty.
# seedexeccache provides exec-cred capability only (no management token in store).
# v2 protocol: proto sentinel + words (--cluster flag last, no value in argv) +
# --rancher-completion-cur=testcluster → ParseArgTail sees --cluster as last flag
# → SiteFlagValue(cluster). fetchClusters returns nil (IDOnly=true).
seedexeccache default-ctx c-test
exec rancher --rancher-completion-proto=2 get namespace --cluster --rancher-completion-cur=testcluster --generate-shell-completion
! stdout .

# AC-30: exec-cred-only + completed cluster ID + empty currentWord → namespace positional site.
# v2 protocol: proto sentinel + words (--cluster c-test consumed in argv) +
# --rancher-completion-cur=def → ParseArgTail consumes --cluster+c-test → SitePositional(0).
# Single exec-cred entry for c-test authorises /k8s/clusters/c-test/api/v1/namespaces;
# facade proxies to envtest which has "default". Use realistic prefix "def" so the
# assertion survives shell-side prefix filtering if ever applied.
exec rancher --rancher-completion-proto=2 get namespace --cluster c-test --rancher-completion-cur=def --generate-shell-completion
stdout '(?m)^default$'

# AC-30 both-sides confirmation: completing the cluster value vs next positional.
# (a) cluster partial "c-" with exec-cred only → empty (IDOnly, fetchClusters nil).
exec rancher --rancher-completion-proto=2 get namespace --cluster --rancher-completion-cur=c- --generate-shell-completion
! stdout .
# (b) same cluster c-test already complete, empty currentWord → namespace list appears.
exec rancher --rancher-completion-proto=2 get namespace --cluster c-test --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^default$'

# AC-role: role completion with full management token (TEST_RANCHER_TOKEN = testToken,
# IDOnly=false). RANCHER_CLI_URL + RANCHER_CLI_CACERT already set above.
# Seed: e2e-global-role (GlobalRole), e2e-project-role (RoleTemplate context=project),
# e2e-cluster-role (RoleTemplate context=cluster) are seeded once in TestMain.
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# Global scope: --global --role <TAB> → fetchGlobalRoles → contains e2e-global-role.
exec rancher --rancher-completion-proto=2 grant x --global --role --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^e2e-global-role$'

# Project scope: --project --cluster --role <TAB> → fetchRoleTemplates(project) → contains e2e-project-role.
exec rancher --rancher-completion-proto=2 grant x --project p-x --cluster c-x --role --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^e2e-project-role$'

# Cluster scope: --cluster --role <TAB> → fetchRoleTemplates(cluster) → contains e2e-cluster-role, not e2e-project-role.
exec rancher --rancher-completion-proto=2 grant x --cluster c-test --role --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^e2e-cluster-role$'
! stdout e2e-project-role

# No scope: --role <TAB> with no scope flag → roleVocabNone → empty.
exec rancher --rancher-completion-proto=2 grant x --role --rancher-completion-cur= --generate-shell-completion
! stdout .

# AC-subject: grant positional subject completion with full management token.
# Seeded users: e2e-compl-u1 (username=e2e-compl-user1), e2e-compl-u2 (username=e2e-compl-user2).
# Both metadata.name and username spellings must appear as candidates.
exec rancher --rancher-completion-proto=2 grant --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^e2e-compl-u1$'
stdout '(?m)^e2e-compl-user1$'
stdout '(?m)^e2e-compl-u2$'
stdout '(?m)^e2e-compl-user2$'

# revoke also completes subjects.
exec rancher --rancher-completion-proto=2 revoke --rancher-completion-cur= --generate-shell-completion
stdout '(?m)^e2e-compl-u1$'
stdout '(?m)^e2e-compl-user1$'
stdout '(?m)^e2e-compl-u2$'
stdout '(?m)^e2e-compl-user2$'

env RANCHER_CLI_TOKEN=

# Corrupt config: the SC-1 hard requirement extends to the TAB-time
# callback, not just the Before-path — a missing/corrupt config must
# degrade to empty output, exit 0, never error text (an error line would be
# offered as a shell candidate).
cp garbage-config.yaml $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher config use-context --generate-shell-completion
! stdout .

-- seed-config.yaml --
currentContext: acme
servers:
  acme:
    url: https://acme.example.com
contexts:
  acme:
    server: acme

-- garbage-config.yaml --
not: [valid yaml
