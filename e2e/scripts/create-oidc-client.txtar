env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# oidc-provider enabled: the capability check must proceed (envtest cannot
# serve /rancherversion, so PRIME_REQUIRED/Disabled are covered by
# surface/cli's own httptest-backed unit tests, not here — see
# oidcclient_capability_acceptance_test.go). Seeded ONCE, in this one
# scenario file: "oidc-provider" is a fixed, production-real Feature name
# that cannot be scenario-namespaced, and testscript scenarios share one
# envtest cluster and run concurrently — a second seed attempt elsewhere
# would collide (see ext-kinds.txtar, which no longer assumes an empty
# Feature list for exactly this reason).
seedobj management.cattle.io/v3/features . oidc-feature.yaml
exec rancher create namespace cattle-oidc-client-secrets --cluster local --apply

# --- create oidc-client ---
#
# Background create; no controller runs in this harness, so the
# provisioning wait is satisfied the same way wait-success.txtar satisfies
# a GitRepo wait: flip status directly, then seed the backing Secret the
# post-wait delivery read GETs.
exec rancher create oidc-client create-test --description e2e-test --redirect-uri https://example.invalid/callback --scope openid --token-ttl 1h --refresh-ttl 24h --apply --yes -o json &createcmd&
exec sleep 1
flipstatus local management.cattle.io/v3/oidcclients . create-test {"clientID":"client-e2e-1","clientSecrets":{"client-secret-1":{"createdAt":"1700000000","lastFiveCharacters":"vXyZ1"}}}
seedobj core/v1/secrets cattle-oidc-client-secrets secret.yaml
wait createcmd

jsonquery stdout data.name create-test
jsonquery stdout data.clientID client-e2e-1
jsonquery stdout data.secretName client-secret-1
jsonquery stdout data.clientSecret super-secret-value
jsonquery stdout 'warnings.0' 'this client secret is shown exactly once — store it now'

# The façade serves no /oidc/.well-known/openid-configuration route, so
# discovery degrades: issuer is derived from the effective base, endpoints
# are omitted, and a second warning names what failed — a committed create
# must never fail on discovery quality.
jsonquery stdout data.issuer ${TEST_RANCHER_URL}/oidc
jsonquery stdout data.endpoints ''
stdout 'could not confirm the discovery document'

# -o name is rejected before Plan for this once-only command — zero total
# requests, never a silent invalidate-and-discard.
! exec rancher create oidc-client name-rejected -o name --apply --yes
jsonquery stderr data.error.code VALIDATION

# --- oidc-client add-secret / rotate-secret / remove-secret ---
#
# A second, already-provisioned client. Status is set via flipstatus, not
# embedded in the seedobj YAML: a CRD with a status subresource strips
# status from the main create call, exactly like a real Kubernetes
# apiserver — only the status subresource endpoint (flipstatus) can set it,
# even for the FIRST write.
seedobj management.cattle.io/v3/oidcclients . lifecycle-client.yaml
flipstatus local management.cattle.io/v3/oidcclients . lifecycle-client {"clientID":"client-lc-1","clientSecrets":{"client-secret-1":{"createdAt":"1700000000","lastFiveCharacters":"aaaaa"}}}
seedobj core/v1/secrets cattle-oidc-client-secrets lifecycle-secret.yaml

# add-secret: baseline {client-secret-1} -> {client-secret-1, client-secret-2}.
# The controller's half (consuming the annotation, updating status, minting
# the backing value) is simulated the same way wait-success.txtar simulates
# Fleet: a short pause for the real annotation write to land, then the
# generic `patch` verb (the reviewed power-user escape hatch, design's
# accepted residual asymmetry) removes the annotation and `patch secret`/
# flipstatus apply the controller's effect — all well inside the bespoke
# verb's 2s poll tick.
exec rancher oidc-client add-secret lifecycle-client --apply --yes -o json &addcmd&
exec sleep 1
exec rancher patch oidcclient lifecycle-client --patch '[{"op":"remove","path":"/metadata/annotations/cattle.io~1oidc-client-secret-create"}]' --apply --yes
exec rancher patch secret client-lc-1 --namespace cattle-oidc-client-secrets --cluster local --patch '[{"op":"add","path":"/data/client-secret-2","value":"bmV3LXNlY3JldC0yLXZhbHVl"}]' --apply --yes
flipstatus local management.cattle.io/v3/oidcclients . lifecycle-client {"clientSecrets":{"client-secret-2":{"createdAt":"1700000100","lastFiveCharacters":"bbbbb"}}}
wait addcmd
jsonquery stdout data.clientID client-lc-1
jsonquery stdout data.secretName client-secret-2
jsonquery stdout data.clientSecret new-secret-2-value
jsonquery stdout 'warnings.0' 'creates a new client secret on lifecycle-client'
jsonquery stdout 'warnings.1' 'this client secret is shown exactly once — store it now'

# rotate-secret: client-secret-1's BACKING VALUE changes; its status entry
# (createdAt, key set) does not.
exec rancher oidc-client rotate-secret lifecycle-client client-secret-1 --apply --yes -o json &rotatecmd&
exec sleep 1
exec rancher patch oidcclient lifecycle-client --patch '[{"op":"remove","path":"/metadata/annotations/cattle.io~1oidc-client-secret-regenerate"}]' --apply --yes
exec rancher patch secret client-lc-1 --namespace cattle-oidc-client-secrets --cluster local --patch '[{"op":"replace","path":"/data/client-secret-1","value":"cm90YXRlZC12YWx1ZS0x"}]' --apply --yes
wait rotatecmd
jsonquery stdout data.clientID client-lc-1
jsonquery stdout data.secretName client-secret-1
jsonquery stdout data.clientSecret rotated-value-1

# rotate-secret omitting the name is a VALIDATION error once more than one
# secret exists (client-secret-1 and client-secret-2 both remain).
! exec rancher oidc-client rotate-secret lifecycle-client --apply --yes
jsonquery stderr data.error.code VALIDATION

# rotate-secret naming an unknown secret lists the real names as candidates,
# never a silent no-op or a poll to timeout.
! exec rancher oidc-client rotate-secret lifecycle-client client-secret-typo --apply --yes
jsonquery stderr data.error.code VALIDATION
jsonquery stderr 'data.error.candidates.#(id=="client-secret-1").id' client-secret-1

# remove-secret: client-secret-2 leaves the status key set; client-secret-1
# remains untouched.
exec rancher oidc-client remove-secret lifecycle-client client-secret-2 --apply --yes -o json &removecmd&
exec sleep 1
exec rancher patch oidcclient lifecycle-client --patch '[{"op":"remove","path":"/metadata/annotations/cattle.io~1oidc-client-secret-remove"}]' --apply --yes
flipstatus local management.cattle.io/v3/oidcclients . lifecycle-client {"clientSecrets":{"client-secret-2":null}}
wait removecmd
jsonquery stdout data.clientID client-lc-1
jsonquery stdout data.secretName client-secret-2

exec rancher get oidcclient lifecycle-client -o json
jsonquery stdout 'data.status.clientSecrets.client-secret-1.lastFiveCharacters' aaaaa
jsonquery stdout 'data.status.clientSecrets.client-secret-2' ''

-- oidc-feature.yaml --
apiVersion: management.cattle.io/v3
kind: Feature
metadata:
  name: oidc-provider
spec:
  value: true
-- secret.yaml --
apiVersion: v1
kind: Secret
metadata:
  name: client-e2e-1
  namespace: cattle-oidc-client-secrets
data:
  client-secret-1: c3VwZXItc2VjcmV0LXZhbHVl
-- lifecycle-client.yaml --
apiVersion: management.cattle.io/v3
kind: OIDCClient
metadata:
  name: lifecycle-client
spec:
  tokenExpirationSeconds: 3600
  refreshTokenExpirationSeconds: 86400
-- lifecycle-secret.yaml --
apiVersion: v1
kind: Secret
metadata:
  name: client-lc-1
  namespace: cattle-oidc-client-secrets
data:
  client-secret-1: b2xkLXZhbHVlLTE=
