env RANCHER_URL=$TEST_RANCHER_URL
env RANCHER_TOKEN=$TEST_RANCHER_TOKEN

exec rancher create resource -f gitrepo.yaml --apply

! exec rancher get gitrepo failer --wait --timeout 30s -o json &waitcmd&
flipstatus local fleet.cattle.io/v1alpha1/gitrepos fleet-default failer '{"transitioning":"error","transitioningMessage":"quota exceeded"}'
wait waitcmd
stderr 'quota exceeded'
jsonquery stderr data.error.retryable false

-- gitrepo.yaml --
apiVersion: fleet.cattle.io/v1alpha1
kind: GitRepo
metadata:
  name: failer
  namespace: fleet-default
spec:
  repo: https://example.com/repo.git
