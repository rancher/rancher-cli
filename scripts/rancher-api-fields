catalog_actions community "$COMMUNITY_VERSION" "$work/community-catalog.json"
catalog_actions prime "$PRIME_VERSION" "$work/prime-catalog.json"
auth_config_types community "$COMMUNITY_VERSION" "$COMMUNITY_CLIENT_VERSION" "$COMMUNITY_VERSION" "$work/community-authconfig.json"
auth_config_types prime "$PRIME_VERSION" "$PRIME_CLIENT_VERSION" "$PRIME_VERSION" "$work/prime-authconfig.json"

(
  cd "$work/merge"
  run "creating the merge module" go mod init rancherapifieldsmerge
  if ! go run . "$module" \
    community "$COMMUNITY_IMAGE" "$COMMUNITY_LABEL" "$COMMUNITY_COMMIT" "$COMMUNITY_VERSION" "$COMMUNITY_CLIENT_VERSION" "$work/community.json" "$work/community-catalog.json" "$work/community-authconfig.json" \
    prime "$PRIME_IMAGE" "$PRIME_LABEL" "$PRIME_COMMIT" "$PRIME_VERSION" "$PRIME_CLIENT_VERSION" "$work/prime.json" "$work/prime-catalog.json" "$work/prime-authconfig.json" >"$work/golden.json" 2>"$work/merge.log"; then
    echo "error: merging the field lists failed:" >&2
    cat "$work/merge.log" >&2
    exit 1
  fi
)

if [ "${RANCHER_API_FIELDS_UPDATE:-}" = "1" ]; then
  cp "$work/golden.json" "$GOLDEN"
  echo "wrote $GOLDEN"
  exit 0
fi
if ! diff -u "$GOLDEN" "$work/golden.json"; then
  echo "error: $GOLDEN differs from the pinned Rancher API types; run make rancher-api-fields-update and review the diff" >&2
  exit 1
fi
