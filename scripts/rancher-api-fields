#!/usr/bin/env bash
set -euo pipefail

# Reads the top-level fields of the Rancher API types the bespoke create
# commands build - the direct fields of each resource's spec, and of the
# User itself, which has no spec - from github.com/rancher/rancher/pkg/apis
# at the commits of the two oracle images pinned in scripts/e2e-fidelity,
# and compares them with internal/cli/testdata/rancher-api-fields.golden.json.
# RANCHER_API_FIELDS_UPDATE=1 (make rancher-api-fields-update) writes the
# golden instead; review its diff like the schema golden. The golden lists
# the union of both editions, each field with the editions that have it.
#
# The same commits also give the JSON field names of the catalog action
# request types ChartInstallAction, ChartInstall, ChartUpgradeAction,
# ChartUpgrade and ChartUninstallAction. They are read from
# pkg/api/steve/catalog/types/rest.go of the root module
# github.com/rancher/rancher at the same pseudo-version, downloaded with go
# mod download and parsed with go/parser, so the module is never imported and
# its replace directives do not matter. The download is about 5 MB per
# edition and unpacks to about 25 MB in the module cache, which stays the
# default one: the unpacked files are read-only, so a cache inside the
# temporary directory would make its removal on exit fail.
#
# The module is required in a throwaway module in a temporary directory,
# removed on exit, never in this repository: a go.mod or go.sum here that
# named it would make manifest scanners (trivy fs, osv-scanner, Dependabot)
# report every advisory of its dependency tree against this repository.
# Needs network access to the Go module proxy on a cold module cache, and to
# the registries of the two images.

# Each oracle image names its Rancher commit in a label; label_key below
# says which label per edition. The images are the ORACLE_IMAGE and
# PRIME_ORACLE_IMAGE assignments of scripts/e2e-fidelity, read the way
# TestRancherAPIFieldsPinsMatchOracles (internal/cli) reads them, and the
# golden records each image, label and commit. The label values are the
# only other input: the module proxy names the pkg/apis pseudo-version of
# each commit, which the golden records too.
# RANCHER_API_FIELDS_LABELS_FILE names a JSON file that stands in for the
# registry read, for tests: one object keyed by edition, each value the
# output of docker buildx imagetools inspect --format '{{json .Image}}'.
module="github.com/rancher/rancher/pkg/apis"
root_module="github.com/rancher/rancher"

cd "$(dirname "$0")/.."
GOLDEN="internal/cli/testdata/rancher-api-fields.golden.json"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# run runs a command with its output kept aside, and on failure prints what
# it was doing, the command and its output, then exits.
run() {
  local what=$1 log
  shift
  log="$work/run.log"
  if ! "$@" >"$log" 2>&1; then
    echo "error: $what failed: $*" >&2
    cat "$log" >&2
    exit 1
  fi
}

# label_key sets the variable named by its second argument to the label that
# names the Rancher commit of the edition's oracle image.
label_key() {
  case $1 in
    community) printf -v "$2" '%s' org.opencontainers.image.revision ;;
    prime) printf -v "$2" '%s' org.opencontainers.image.oss.revision ;;
    *)
      echo "error: no label is set for the edition $1" >&2
      exit 1
      ;;
  esac
}

# pinned_image sets the variable named by its second argument to the first
# NAME="value" line of scripts/e2e-fidelity, the pattern the guard test
# uses. The file is never sourced: it runs the harness.
pinned_image() {
  local line
  if ! line=$(grep -m1 -E "^$1=\"[^\"]+\"\$" scripts/e2e-fidelity); then
    echo "error: scripts/e2e-fidelity has no $1=\"...\" line" >&2
    exit 1
  fi
  line=${line#*=\"}
  printf -v "$2" '%s' "${line%\"}"
}

# read_commit sets the variable named by its third argument to the Rancher
# commit the image of the edition names in its label. The labels come from
# the registry, three tries 5 seconds apart, or from the file named by
# RANCHER_API_FIELDS_LABELS_FILE, which is read without a registry call. Like
# resolve_version it runs in the script's own shell, so every step that can
# fail is checked and stops the script with a message.
read_commit() {
  local edition=$1 image=$2 key raw commit attempt=1
  label_key "$edition" key
  if [ -n "${RANCHER_API_FIELDS_LABELS_FILE:-}" ]; then
    if [ "${RANCHER_API_FIELDS_UPDATE:-}" = "1" ]; then
      echo "error: RANCHER_API_FIELDS_LABELS_FILE is set; the golden is written only from the registries' labels" >&2
      exit 1
    fi
    echo "note: the $edition labels come from RANCHER_API_FIELDS_LABELS_FILE=$RANCHER_API_FIELDS_LABELS_FILE, not from the registry" >&2
    if ! commit=$("$work/labels/labels" "$key" "$RANCHER_API_FIELDS_LABELS_FILE" "$edition" 2>&1); then
      echo "error: cannot read the $edition commit from label $key of $image:" >&2
      echo "$commit" >&2
      exit 1
    fi
  else
    if ! command -v docker >/dev/null 2>&1; then
      echo "error: reading the labels of $image needs docker with buildx" >&2
      exit 1
    fi
    while ! raw=$(docker buildx imagetools inspect "$image" --format '{{json .Image}}' 2>"$work/buildx.err"); do
      if [ "$attempt" -ge 3 ]; then
        echo "error: cannot read the labels of $image after $attempt attempts:" >&2
        cat "$work/buildx.err" >&2
        exit 1
      fi
      attempt=$((attempt + 1))
      sleep 5
    done
    if ! commit=$("$work/labels/labels" "$key" <<<"$raw" 2>&1); then
      echo "error: cannot read the $edition commit from label $key of $image:" >&2
      echo "$commit" >&2
      exit 1
    fi
  fi
  echo "$edition: label $key of $image is $commit"
  printf -v "$3" '%s' "$commit"
}

# resolve_version sets the variable named by its second argument to the
# pkg/apis pseudo-version of the commit, which is 40 lowercase hex digits.
# It runs in the script's own shell, not in a command substitution, where
# bash would ignore set -e; every step that can fail is checked and stops
# the script with a message.
resolve_version() {
  local commit=$1 info version
  if [ ! -f "$work/resolve/go.mod" ]; then
    mkdir -p "$work/resolve"
    (cd "$work/resolve" && run "creating the module that resolves versions" go mod init rancherapifieldsresolve)
  fi
  if ! info=$(cd "$work/resolve" && go list -m -json "$module@$commit" 2>&1); then
    echo "error: cannot resolve $module at commit $commit:" >&2
    echo "$info" >&2
    exit 1
  fi
  version=$(sed -n 's/^[[:space:]]*"Version": "\(.*\)",$/\1/p' <<<"$info")
  if [ -z "$version" ] || [ "${version##*-}" != "${commit:0:12}" ]; then
    echo "error: the module proxy named \"$version\" for $module at commit $commit:" >&2
    echo "$info" >&2
    exit 1
  fi
  printf -v "$2" '%s' "$version"
}
# The temporary modules must never see this repository's go.work or a
# vendor directory, and may update their own go.mod freely.
export GOWORK=off GOFLAGS=-mod=mod

mkdir -p "$work/extract" "$work/merge" "$work/labels" "$work/catalog"
cat >"$work/labels/main.go" <<'GOEOF'
// Command labels prints the commit an oracle image names in one label. It
// reads the output of docker buildx imagetools inspect --format
// '{{json .Image}}' from standard input: a map keyed by platform for a
// multi-platform image, or one object for a single-platform image. With a
// file and an edition after the label key, it reads that edition's entry of
// a JSON object in the file instead. Every platform must carry the label
// with the same value, 40 lowercase hex digits.
package main

import (
	"encoding/json"
	"fmt"
	"io"
	"os"
	"regexp"
	"sort"
)

var commitRE = regexp.MustCompile(`^[0-9a-f]{40}$`)

type image struct {
	Config *struct {
		Labels map[string]string `json:"Labels"`
	} `json:"config"`
}

func main() {
	commit, err := run(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(commit)
}

func run(args []string) (string, error) {
	if len(args) != 1 && len(args) != 3 {
		return "", fmt.Errorf("want the label key, and optionally a file and an edition")
	}
	var raw []byte
	var err error
	if len(args) == 3 {
		raw, err = entry(args[1], args[2])
	} else {
		raw, err = io.ReadAll(os.Stdin)
	}
	if err != nil {
		return "", err
	}
	return commit(raw, args[0])
}

func entry(path, edition string) ([]byte, error) {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil, err
	}
	var byEdition map[string]json.RawMessage
	if err := json.Unmarshal(data, &byEdition); err != nil {
		return nil, fmt.Errorf("%s: %w", path, err)
	}
	raw, ok := byEdition[edition]
	if !ok {
		return nil, fmt.Errorf("%s has no entry for the edition %s", path, edition)
	}
	return raw, nil
}

func commit(raw []byte, key string) (string, error) {
	var top map[string]json.RawMessage
	if err := json.Unmarshal(raw, &top); err != nil {
		return "", fmt.Errorf("cannot parse the image description: %w", err)
	}
	platforms := map[string]json.RawMessage{}
	if _, ok := top["config"]; ok {
		platforms["single platform"] = raw
	} else {
		for name, desc := range top {
			if name != "unknown/unknown" {
				platforms[name] = desc
			}
		}
	}
	if len(platforms) == 0 {
		return "", fmt.Errorf("the image description names no platform")
	}
	names := make([]string, 0, len(platforms))
	for name := range platforms {
		names = append(names, name)
	}
	sort.Strings(names)
	var first, firstName string
	for _, name := range names {
		var img image
		if err := json.Unmarshal(platforms[name], &img); err != nil {
			return "", fmt.Errorf("%s: cannot parse the image description: %w", name, err)
		}
		value, ok := "", false
		if img.Config != nil {
			value, ok = img.Config.Labels[key]
		}
		if !ok {
			return "", fmt.Errorf("%s: the image has no label %s", name, key)
		}
		if !commitRE.MatchString(value) {
			return "", fmt.Errorf("%s: label %s is %q, not 40 lowercase hex digits", name, key, value)
		}
		if first == "" {
			first, firstName = value, name
		} else if value != first {
			return "", fmt.Errorf("the platforms disagree on label %s: %s has %s, %s has %s", key, firstName, first, name, value)
		}
	}
	return first, nil
}
GOEOF
(
  cd "$work/labels"
  run "creating the label reader module" go mod init rancherapifieldslabels
  run "building the label reader" go build -o labels .
)

cat >"$work/catalog/main.go" <<'GOEOF'
// Command catalog prints, as JSON, the JSON field names of the catalog
// action request types in pkg/api/steve/catalog/types/rest.go of a
// downloaded github.com/rancher/rancher module. It reads the output of go
// mod download -json for the module from standard input and takes the
// module path and the expected version as arguments. The file is parsed,
// never compiled, and the names follow encoding/json: a field's json tag
// name, else its Go name; a tag of "-" and an unexported field are skipped;
// an embedded struct without a json name is flattened into its parent.
package main

import (
	"encoding/json"
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"io"
	"os"
	"path/filepath"
	"reflect"
	"sort"
	"strconv"
	"strings"
)

const restFile = "pkg/api/steve/catalog/types/rest.go"

var typeNames = []string{
	"ChartInstallAction",
	"ChartInstall",
	"ChartUpgradeAction",
	"ChartUpgrade",
	"ChartUninstallAction",
}

type download struct {
	Path    string
	Version string
	Dir     string
	Error   string
}

type result struct {
	Type   string   `json:"type"`
	Fields []string `json:"fields"`
}

func main() {
	out, err := run(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run(args []string) ([]result, error) {
	if len(args) != 2 {
		return nil, fmt.Errorf("want the module path and its version")
	}
	raw, err := io.ReadAll(os.Stdin)
	if err != nil {
		return nil, err
	}
	var d download
	if err := json.Unmarshal(raw, &d); err != nil {
		return nil, fmt.Errorf("cannot parse the output of go mod download: %w", err)
	}
	if d.Error != "" {
		return nil, fmt.Errorf("go mod download: %s", d.Error)
	}
	if d.Path != args[0] || d.Version != args[1] {
		return nil, fmt.Errorf("go mod download returned %s@%s, want %s@%s", d.Path, d.Version, args[0], args[1])
	}
	if d.Dir == "" {
		return nil, fmt.Errorf("go mod download reported no directory for %s@%s", d.Path, d.Version)
	}
	path := filepath.Join(d.Dir, filepath.FromSlash(restFile))
	file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
	if err != nil {
		return nil, err
	}
	structs := map[string]*ast.StructType{}
	for _, decl := range file.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || gen.Tok != token.TYPE {
			continue
		}
		for _, spec := range gen.Specs {
			ts := spec.(*ast.TypeSpec)
			if st, ok := ts.Type.(*ast.StructType); ok {
				structs[ts.Name.Name] = st
			}
		}
	}
	var out []result
	for _, name := range typeNames {
		fields, err := jsonNames(structs, name, nil)
		if err != nil {
			return nil, fmt.Errorf("%s in %s: %w", name, restFile, err)
		}
		sort.Strings(fields)
		out = append(out, result{Type: name, Fields: fields})
	}
	return out, nil
}

func jsonNames(structs map[string]*ast.StructType, name string, path []string) ([]string, error) {
	st, ok := structs[name]
	if !ok {
		return nil, fmt.Errorf("no struct type %s", name)
	}
	for _, p := range path {
		if p == name {
			return nil, fmt.Errorf("embedded %s contains itself", name)
		}
	}
	path = append(path, name)
	var names []string
	add := func(n string) error {
		for _, have := range names {
			if have == n {
				return fmt.Errorf("the json name %q appears twice", n)
			}
		}
		names = append(names, n)
		return nil
	}
	for _, f := range st.Fields.List {
		tag := ""
		if f.Tag != nil {
			unquoted, err := strconv.Unquote(f.Tag.Value)
			if err != nil {
				return nil, err
			}
			tag = reflect.StructTag(unquoted).Get("json")
		}
		if tag == "-" {
			continue
		}
		tagName, _, _ := strings.Cut(tag, ",")
		if len(f.Names) == 0 {
			embedded, err := embeddedName(f.Type)
			if err != nil {
				return nil, err
			}
			if tagName == "" {
				inner, err := jsonNames(structs, embedded, path)
				if err != nil {
					return nil, fmt.Errorf("embedded %s: %w", embedded, err)
				}
				for _, n := range inner {
					if err := add(n); err != nil {
						return nil, err
					}
				}
				continue
			}
			if !ast.IsExported(embedded) {
				continue
			}
			if err := add(tagName); err != nil {
				return nil, err
			}
			continue
		}
		for _, n := range f.Names {
			if !n.IsExported() {
				continue
			}
			jsonName := tagName
			if jsonName == "" {
				jsonName = n.Name
			}
			if err := add(jsonName); err != nil {
				return nil, err
			}
		}
	}
	return names, nil
}

func embeddedName(expr ast.Expr) (string, error) {
	switch e := expr.(type) {
	case *ast.Ident:
		return e.Name, nil
	case *ast.StarExpr:
		return embeddedName(e.X)
	}
	return "", fmt.Errorf("an embedded field of a type from another package or a generic type cannot be followed")
}
GOEOF
(
  cd "$work/catalog"
  run "creating the catalog reader module" go mod init rancherapifieldscatalog
  run "building the catalog reader" go build -o catalog .
)

cat >"$work/extract/main.go" <<'EOF'
// Command extract prints, as JSON, the top-level fields of the Rancher API
// types the bespoke create commands build: one level only, the json names
// of a resource's spec fields, or of the object itself when it has no spec.
package main

import (
	"encoding/json"
	"os"
	"reflect"
	"sort"
	"strings"

	extv1 "github.com/rancher/rancher/pkg/apis/ext.cattle.io/v1"
	mgmtv3 "github.com/rancher/rancher/pkg/apis/management.cattle.io/v3"
	provv1 "github.com/rancher/rancher/pkg/apis/provisioning.cattle.io/v1"
)

type resource struct {
	Resource string   `json:"resource"`
	Path     string   `json:"path"`
	Fields   []string `json:"fields"`
}

// objectFields are present on every object and set by the server or the
// command's own framing, never by a field flag.
var objectFields = map[string]bool{"apiVersion": true, "kind": true, "metadata": true, "status": true}

func main() {
	out := []resource{
		spec("ext.cattle.io/v1 Kubeconfig", extv1.Kubeconfig{}),
		spec("ext.cattle.io/v1 PasswordChangeRequest", extv1.PasswordChangeRequest{}),
		spec("ext.cattle.io/v1 Token", extv1.Token{}),
		spec("management.cattle.io/v3 OIDCClient", mgmtv3.OIDCClient{}),
		spec("management.cattle.io/v3 Project", mgmtv3.Project{}),
		top("management.cattle.io/v3 User", mgmtv3.User{}),
		spec("provisioning.cattle.io/v1 Cluster", provv1.Cluster{}),
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(out); err != nil {
		panic(err)
	}
}

func spec(name string, obj any) resource {
	for _, f := range fields(reflect.TypeOf(obj)) {
		if f.name == "spec" {
			return resource{Resource: name, Path: "spec", Fields: names(fields(f.typ), nil)}
		}
	}
	panic(name + " has no spec field")
}

func top(name string, obj any) resource {
	return resource{Resource: name, Path: "", Fields: names(fields(reflect.TypeOf(obj)), objectFields)}
}

type field struct {
	name string
	typ  reflect.Type
}

// fields returns t's json fields the way encoding/json sees them: embedded
// structs without a json name are flattened into the parent.
func fields(t reflect.Type) []field {
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	var out []field
	for i := range t.NumField() {
		sf := t.Field(i)
		tag := sf.Tag.Get("json")
		if tag == "-" {
			continue
		}
		name, _, _ := strings.Cut(tag, ",")
		if sf.Anonymous && name == "" {
			out = append(out, fields(sf.Type)...)
			continue
		}
		if !sf.IsExported() {
			continue
		}
		if name == "" {
			name = sf.Name
		}
		out = append(out, field{name: name, typ: sf.Type})
	}
	return out
}

func names(fs []field, skip map[string]bool) []string {
	var out []string
	for _, f := range fs {
		if !skip[f.name] {
			out = append(out, f.name)
		}
	}
	sort.Strings(out)
	return out
}
EOF

cat >"$work/merge/main.go" <<'EOF'
// Command merge writes the golden: the union of the per-edition field
// lists, each field with the editions whose types have it, for the resource
// specs and for the catalog action types.
package main

import (
	"encoding/json"
	"os"
	"sort"
)

type resource struct {
	Resource string   `json:"resource"`
	Path     string   `json:"path"`
	Fields   []string `json:"fields"`
}

type oracle struct {
	Image         string `json:"image"`
	Label         string `json:"label"`
	Commit        string `json:"commit"`
	PseudoVersion string `json:"pseudoVersion"`
}

type catalogAction struct {
	Type   string   `json:"type"`
	Fields []string `json:"fields"`
}

type goldenResource struct {
	Resource string              `json:"resource"`
	Path     string              `json:"path"`
	Fields   map[string][]string `json:"fields"`
}

type goldenCatalogAction struct {
	Type   string              `json:"type"`
	Fields map[string][]string `json:"fields"`
}

type golden struct {
	Module         string                `json:"module"`
	Oracles        map[string]oracle     `json:"oracles"`
	Resources      []goldenResource      `json:"resources"`
	CatalogActions []goldenCatalogAction `json:"catalogActions"`
}

// Arguments: module, then edition image label commit pseudo-version
// extract-output catalog-output, once per oracle.
func main() {
	args := os.Args[1:]
	g := golden{Module: args[0], Oracles: map[string]oracle{}}
	byName := map[string]*goldenResource{}
	var order []string
	catalogByType := map[string]*goldenCatalogAction{}
	var catalogOrder []string
	if (len(args)-1)%7 != 0 {
		panic("want the module, then seven arguments per oracle")
	}
	for i := 1; i < len(args); i += 7 {
		edition, image, label, commit, version, path, catalogPath := args[i], args[i+1], args[i+2], args[i+3], args[i+4], args[i+5], args[i+6]
		g.Oracles[edition] = oracle{Image: image, Label: label, Commit: commit, PseudoVersion: version}
		catalogRaw, err := os.ReadFile(catalogPath)
		if err != nil {
			panic(err)
		}
		var cas []catalogAction
		if err := json.Unmarshal(catalogRaw, &cas); err != nil {
			panic(err)
		}
		for _, ca := range cas {
			gc, ok := catalogByType[ca.Type]
			if !ok {
				gc = &goldenCatalogAction{Type: ca.Type, Fields: map[string][]string{}}
				catalogByType[ca.Type] = gc
				catalogOrder = append(catalogOrder, ca.Type)
			}
			for _, f := range ca.Fields {
				gc.Fields[f] = append(gc.Fields[f], edition)
			}
		}
		raw, err := os.ReadFile(path)
		if err != nil {
			panic(err)
		}
		var rs []resource
		if err := json.Unmarshal(raw, &rs); err != nil {
			panic(err)
		}
		for _, r := range rs {
			gr, ok := byName[r.Resource]
			if !ok {
				gr = &goldenResource{Resource: r.Resource, Path: r.Path, Fields: map[string][]string{}}
				byName[r.Resource] = gr
				order = append(order, r.Resource)
			}
			if gr.Path != r.Path {
				panic(r.Resource + ": the editions disagree on the path of its fields")
			}
			for _, f := range r.Fields {
				gr.Fields[f] = append(gr.Fields[f], edition)
			}
		}
	}
	sort.Strings(order)
	for _, name := range order {
		gr := byName[name]
		for _, editions := range gr.Fields {
			sort.Strings(editions)
		}
		g.Resources = append(g.Resources, *gr)
	}
	for _, name := range catalogOrder {
		gc := catalogByType[name]
		for _, editions := range gc.Fields {
			sort.Strings(editions)
		}
		g.CatalogActions = append(g.CatalogActions, *gc)
	}
	enc := json.NewEncoder(os.Stdout)
	enc.SetIndent("", "  ")
	if err := enc.Encode(g); err != nil {
		panic(err)
	}
}
EOF

extract() {
  local version=$1 out=$2 info modfile replace
  (
    cd "$work/extract"
    rm -f go.mod go.sum
    run "creating the temporary module" go mod init rancherapifields
    run "requiring $module@$version" go mod edit -require="$module@$version"
    # pkg/apis builds only with the k8s.io versions its own go.mod
    # replaces to, and replace directives apply to the main module alone,
    # so they are copied here; a replacement by a local path is skipped.
    if ! info=$(go mod download -json "$module@$version" 2>&1); then
      echo "error: cannot download $module@$version:" >&2
      echo "$info" >&2
      exit 1
    fi
    modfile=$(sed -n 's/^[[:space:]]*"GoMod": "\(.*\)",$/\1/p' <<<"$info")
    if [ ! -f "$modfile" ]; then
      echo "error: go mod download reported no go.mod for $module@$version:" >&2
      echo "$info" >&2
      exit 1
    fi
    while read -r replace; do
      run "copying the replace directive $replace of $module@$version" go mod edit -replace="$replace"
    done < <(awk '
      /^replace \(/ { block = 1; next }
      block && /^\)/ { block = 0; next }
      /^replace / { sub(/^replace /, ""); line = 1 }
      (block || line) && $2 == "=>" && NF == 4 { print $1 "=" $3 "@" $4 }
      (block || line) && $3 == "=>" && NF == 5 { print $1 "@" $2 "=" $4 "@" $5 }
      { line = 0 }
    ' "$modfile")
    run "resolving the dependencies of $module@$version" go mod tidy
    if ! go run . >"$out" 2>"$work/extract.log"; then
      echo "error: reading the fields of $module@$version failed:" >&2
      cat "$work/extract.log" >&2
      exit 1
    fi
  )
}

# catalog_actions downloads the root module at the pseudo-version and writes
# the json field names of its catalog action types to the file named by the
# third argument. It runs in the script's own shell like resolve_version.
catalog_actions() {
  local edition=$1 version=$2 out=$3 info
  if ! info=$(cd "$work/resolve" && go mod download -json "$root_module@$version" 2>&1); then
    echo "error: cannot download $root_module@$version for the $edition catalog types:" >&2
    echo "$info" >&2
    exit 1
  fi
  if ! "$work/catalog/catalog" "$root_module" "$version" <<<"$info" >"$out" 2>"$work/catalog.log"; then
    echo "error: reading the $edition catalog types of $root_module@$version failed:" >&2
    cat "$work/catalog.log" >&2
    exit 1
  fi
}
pinned_image ORACLE_IMAGE COMMUNITY_IMAGE
pinned_image PRIME_ORACLE_IMAGE PRIME_IMAGE
read_commit community "$COMMUNITY_IMAGE" COMMUNITY_COMMIT
read_commit prime "$PRIME_IMAGE" PRIME_COMMIT
label_key community COMMUNITY_LABEL
label_key prime PRIME_LABEL
resolve_version "$COMMUNITY_COMMIT" COMMUNITY_VERSION
resolve_version "$PRIME_COMMIT" PRIME_VERSION
extract "$COMMUNITY_VERSION" "$work/community.json"
extract "$PRIME_VERSION" "$work/prime.json"
catalog_actions community "$COMMUNITY_VERSION" "$work/community-catalog.json"
catalog_actions prime "$PRIME_VERSION" "$work/prime-catalog.json"

(
  cd "$work/merge"
  run "creating the merge module" go mod init rancherapifieldsmerge
  if ! go run . "$module" \
    community "$COMMUNITY_IMAGE" "$COMMUNITY_LABEL" "$COMMUNITY_COMMIT" "$COMMUNITY_VERSION" "$work/community.json" "$work/community-catalog.json" \
    prime "$PRIME_IMAGE" "$PRIME_LABEL" "$PRIME_COMMIT" "$PRIME_VERSION" "$work/prime.json" "$work/prime-catalog.json" >"$work/golden.json" 2>"$work/merge.log"; then
    echo "error: merging the field lists failed:" >&2
    cat "$work/merge.log" >&2
    exit 1
  fi
)

if [ "${RANCHER_API_FIELDS_UPDATE:-}" = "1" ]; then
  cp "$work/golden.json" "$GOLDEN"
  echo "wrote $GOLDEN"
  exit 0
fi
if ! diff -u "$GOLDEN" "$work/golden.json"; then
  echo "error: $GOLDEN differs from the pinned Rancher API types; run make rancher-api-fields-update and review the diff" >&2
  exit 1
fi
