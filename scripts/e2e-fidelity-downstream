#!/usr/bin/env bash
set -euo pipefail

# Verifies the downstream fidelity goldens (internal/testrancher/fidelity,
# family access-downstream) against a Rancher the caller already runs and
# that already has a downstream cluster - a hand-run comparison of an
# external server (a dev instance, a release candidate) with the goldens
# scripts/e2e-fidelity records against the pinned oracle and its imported
# downstream. Unlike scripts/e2e-fidelity, this never boots Docker or
# bootstraps a server. Never on PRs.

missing=()
for var in E2E_FIDELITY_URL E2E_FIDELITY_ADMIN_TOKEN E2E_FIDELITY_CACERT E2E_FIDELITY_DOWNSTREAM; do
  [ -n "${!var:-}" ] || missing+=("${var}")
done
if [ "${#missing[@]}" -ne 0 ]; then
  echo "error: missing required environment: ${missing[*]}" >&2
  exit 1
fi

# The drift run's variables belong to scripts/e2e-fidelity with
# E2E_FIDELITY_DRIFT=1; this script never runs a drift comparison.
for var in E2E_FIDELITY_DRIFT_REPORT E2E_FIDELITY_DRIFT_KNOWN E2E_FIDELITY_DRIFT_STARTED E2E_FIDELITY_GOLDEN_IMAGE E2E_FIDELITY_GOLDEN_K3S_IMAGE E2E_FIDELITY_DOWNSTREAM_IMAGE; do
  if [ -n "${!var:-}" ]; then
    echo "error: ${var} is set without E2E_FIDELITY_DRIFT=1; unset it" >&2
    exit 1
  fi
done

# E2E_FIDELITY_DOWNSTREAM_UPDATE_FLAG is a fixed internal value ("" or
# "-update"), set only by scripts/e2e-fidelity-downstream-update, never
# user-supplied, so the intentional word-splitting here is safe.
# shellcheck disable=SC2086
go test -tags e2e_fidelity -count=1 -run TestDownstream ./test/e2e/fidelity/ ${E2E_FIDELITY_DOWNSTREAM_UPDATE_FLAG:-}
