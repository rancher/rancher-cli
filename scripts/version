#!/bin/bash
set -e
# Version resolution order: explicit $VERSION, the SHA baked into a
# `git archive` tarball (scripts/archive-sha, stamped via .gitattributes
# export-subst), then the git checkout's HEAD, then "unknown".
#
# The archive stamp is consulted BEFORE git on purpose: `git rev-parse`
# walks UP parent directories, so a tarball extracted anywhere inside an
# unrelated repository (packaging monorepo, docker build context) would
# silently report the enclosing repo's HEAD. In a real checkout the stamp
# file still holds its unexpanded $Format placeholder, so git is used.
if [ -n "$VERSION" ]; then
  echo "$VERSION"
  exit 0
fi
STAMP=$(cat "$(dirname "$0")/archive-sha" 2>/dev/null || echo "")
case "$STAMP" in
  '$Format'*|'')
    COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    ;;
  *)
    COMMIT="$STAMP"
    ;;
esac
echo "dev-${COMMIT}"
