#!/bin/sh
# Create the draft release for $TAG, or attach assets to an existing
# release. Called by .github/workflows/release.yaml with TAG,
# GITHUB_REPOSITORY, and GH_TOKEN in the environment; asset files are
# the arguments.
#
# Also the manual repair tool when a release run needs re-driving
# (e.g. after deleting a duplicate): with gh authenticated and the
# built assets at hand, run
#   TAG=vX.Y.Z GITHUB_REPOSITORY=rancher/rancher-cli scripts/release-upsert dist/* -
# idempotent; existing assets are replaced (--clobber), the release's
# draft/published state is left alone.
#
# Two ways a release is cut: pushing a tag (this script creates the
# draft), or creating the GitHub release first in the UI/API (which
# pushes the tag and triggers the workflow). Upsert so both flows land
# on ONE release.
#
# Why list-and-count instead of `gh release view` or
# GET /releases/tags/<tag>: drafts are not tag-bound until publish, so
# the tags endpoint cannot see them at all, and `gh release view` exits
# 1 for both "not found" and "API failure" - either shortcut misreads a
# state and recreates the duplicate this script exists to prevent.
# Duplicates are not hypothetical: two releases carried
# tag_name v0.1.0-alpha.1 on 2026-08-12 (a published one from the UI
# and the untagged-slug draft an unconditional `gh release create`
# added next to it).
set -eu

[ -n "${TAG:-}" ] || { echo "::error::TAG is not set" >&2; exit 1; }
[ -n "${GITHUB_REPOSITORY:-}" ] || { echo "::error::GITHUB_REPOSITORY is not set" >&2; exit 1; }
[ "$#" -gt 0 ] || { echo "::error::no asset files given" >&2; exit 1; }

# Fetch and count separately: a piped `gh api ... | grep -c || true`
# would swallow an API failure and misread it as "no release yet".
# grep alone exits 1 on zero matches; that one is safe to absorb once
# the listing itself is known-good.
tags="$(gh api "repos/$GITHUB_REPOSITORY/releases" --paginate --jq '.[].tag_name')" || {
  echo "::error::failed to list releases - cannot tell whether $TAG already has one; not creating anything" >&2
  exit 1
}
existing="$(printf '%s\n' "$tags" | grep -cxF "$TAG" || true)"

if [ "$existing" -gt 1 ]; then
  echo "::error::$existing releases already exist for $TAG - delete the duplicates, then re-run" >&2
  exit 1
elif [ "$existing" -eq 1 ]; then
  echo "release for $TAG already exists - uploading assets to it"
  gh release upload "$TAG" "$@" --clobber
else
  prerelease=""
  case "$TAG" in
    *-*) prerelease="--prerelease" ;;
  esac
  # shellcheck disable=SC2086 # $prerelease is deliberately empty-or-flag
  gh release create "$TAG" --draft $prerelease --verify-tag --title "$TAG" "$@"
fi
