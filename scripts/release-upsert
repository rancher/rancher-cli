#!/bin/sh
# Create the draft release for $TAG, or attach assets to the draft that
# exists. Called by .github/workflows/release.yaml with TAG,
# GITHUB_REPOSITORY, and GH_TOKEN in the environment; asset files are
# the arguments.
#
# Also the manual repair tool when a release run needs re-driving
# (e.g. after deleting a duplicate): with gh authenticated and the
# built assets at hand, run
#   TAG=vX.Y.Z GITHUB_REPOSITORY=rancher/rancher-cli scripts/release-upsert dist/* -
# idempotent; existing assets of a draft are replaced (--clobber).
# Re-driving works on a draft or a missing release; a published release
# is refused.
#
# One way to cut a release: a pushed tag runs release.yaml, which calls
# this script. The script creates the draft, or attaches the assets to the
# draft that exists, and refuses a published release: a published release
# takes no new assets.
#
# Why list-and-count instead of `gh release view` or
# GET /releases/tags/<tag>: drafts are not tag-bound until publish, so
# the tags endpoint cannot see them at all, and `gh release view` exits
# 1 for both "not found" and "API failure" - either shortcut misreads a
# state and recreates the duplicate this script exists to prevent.
# The one listing also carries each release's draft state: the count and
# the state come from the same answer.
# Duplicates are not hypothetical: two releases carried
# tag_name v0.1.0-alpha.1 on 2026-08-12 (a published one from the UI
# and the untagged-slug draft an unconditional `gh release create`
# added next to it).
set -eu

[ -n "${TAG:-}" ] || { echo "::error::TAG is not set" >&2; exit 1; }
[ -n "${GITHUB_REPOSITORY:-}" ] || { echo "::error::GITHUB_REPOSITORY is not set" >&2; exit 1; }
[ "$#" -gt 0 ] || { echo "::error::no asset files given" >&2; exit 1; }

# Fetch and match separately: a piped `gh api ... | awk` would swallow an
# API failure and misread it as "no release yet". Each row is the tag, a
# tab, and whether the release is a draft. Tags are compared as whole
# strings: a regular expression would let a "." match any character.
releases="$(gh api "repos/$GITHUB_REPOSITORY/releases" --paginate --jq '.[] | [.tag_name, (.draft | tostring)] | @tsv')" || {
  echo "::error::failed to list releases - cannot tell whether $TAG already has one; not creating anything" >&2
  exit 1
}
existing="$(printf '%s\n' "$releases" | awk -F'\t' -v t="$TAG" '$1 == t { n++ } END { print n + 0 }')"

if [ "$existing" -gt 1 ]; then
  echo "::error::$existing releases already exist for $TAG - delete the duplicates, then re-run" >&2
  exit 1
elif [ "$existing" -eq 1 ]; then
  draft="$(printf '%s\n' "$releases" | awk -F'\t' -v t="$TAG" '$1 == t { print $2 }')"
  if [ "$draft" != "true" ]; then
    echo "::error::the release for $TAG is already published - a published release takes no new assets; fix on main and cut the next version" >&2
    exit 1
  fi
  echo "draft release for $TAG already exists - uploading assets to it"
  gh release upload "$TAG" "$@" --clobber --repo "$GITHUB_REPOSITORY"
else
  prerelease=""
  case "$TAG" in
    *-*) prerelease="--prerelease" ;;
  esac
  # shellcheck disable=SC2086 # $prerelease is deliberately empty-or-flag
  gh release create "$TAG" --draft $prerelease --verify-tag --repo "$GITHUB_REPOSITORY" --title "$TAG" "$@"
fi
