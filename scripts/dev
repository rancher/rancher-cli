#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Hermetic dev/verification runner: NEVER touches the operator's real
# config or OS keychain. All manual verification runs go through this -
# never run the binary or `go run ./cmd/rancher` directly (see
# ARCHITECTURE.md for why: an env prefix lost between tool calls is exactly
# how a real keychain once got touched).
dir="${RANCHER_DEV_CONFIG_DIR:-${TMPDIR:-/tmp}/rancher-dev-$(id -u)}"
mkdir -p "$dir"
export RANCHER_CLI_CONFIG_DIR="$dir" RANCHER_CLI_CREDENTIAL_STORE=file
exec go run ./cmd/rancher "$@"
