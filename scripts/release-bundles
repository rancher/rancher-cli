#!/bin/bash
# Copy the Sigstore bundle of each attestation into dist/ under its release
# asset name. release.yaml passes the list in BUNDLES, one line for each
# attestation step: the asset name, a space, and the path of the file in which
# the step wrote its bundle (its bundle-path output).
#
# actions/attest writes one bundle for each step. A file that holds more than
# one JSON value is refused; the script does not try to pick one value. A name
# that exists in dist/ is refused. scripts/release-assets-check checks the
# result.
#
# Needs jq.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v jq >/dev/null 2>&1 || { echo "error: jq is not installed; release-bundles needs it" >&2; exit 1; }
[ -n "${BUNDLES:-}" ] || { echo "error: BUNDLES is not set" >&2; exit 1; }
[ -d dist ] || { echo "error: dist/ does not exist; run scripts/release-build first" >&2; exit 1; }

count=0
while read -r name path extra; do
  [ -n "$name" ] || continue
  if [ -z "$path" ] || [ -n "$extra" ]; then
    echo "error: a line of BUNDLES is not '<asset name> <bundle path>': '$name $path $extra'" >&2
    exit 1
  fi
  case "$name" in
    */* | .*) echo "error: '$name' is not a plain asset name" >&2; exit 1 ;;
  esac
  [ -f "$path" ] || { echo "error: the bundle file '$path' for $name does not exist" >&2; exit 1; }
  values="$(jq -s 'length' "$path")" ||
    { echo "error: the bundle file '$path' for $name is not JSON" >&2; exit 1; }
  [ "$values" -eq 1 ] ||
    { echo "error: the bundle file '$path' for $name holds $values JSON values; it must hold exactly 1" >&2; exit 1; }
  [ ! -e "dist/$name" ] || { echo "error: dist/$name exists already" >&2; exit 1; }
  cp -- "$path" "dist/$name"
  count=$((count + 1))
done <<EOF
$BUNDLES
EOF
[ "$count" -gt 0 ] || { echo "error: BUNDLES lists no bundle" >&2; exit 1; }
