env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# cc-e2etest/e2e-cred (amazonec2) and cc-e2edo/e2e-do-cred (digitalocean)
# are seeded once, globally, in harness_test.go's seedCloudCredential.

exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(secretName=="cc-e2etest").displayName' e2e-cred
jsonquery stdout 'data.#(secretName=="cc-e2etest").driver' amazonec2
jsonquery stdout 'data.#(secretName=="cc-e2etest").id' cattle-global-data:cc-e2etest
jsonquery stdout 'data.#(secretName=="cc-e2edo").displayName' e2e-do-cred
jsonquery stdout 'data.#(secretName=="cc-e2edo").driver' digitalocean

exec rancher get cloud-credential
stdout cc-e2etest
stdout e2e-cred
stdout amazonec2
stdout cc-e2edo
stdout digitalocean

# Get by bare secret name...
exec rancher get cloud-credential cc-e2etest -o json
jsonquery stdout 'data.0.secretName' cc-e2etest
jsonquery stdout 'data.0.driver' amazonec2

# ...and by display name.
exec rancher get cloud-credential e2e-do-cred -o json
jsonquery stdout 'data.0.secretName' cc-e2edo
jsonquery stdout 'data.0.displayName' e2e-do-cred

! exec rancher get cloud-credential does-not-exist -o json
jsonquery stderr data.error.code NOT_FOUND
