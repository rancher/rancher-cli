# Hermetic: skill verbs never touch the server. HOME is scenario-local, so
# user-scope targets resolve inside the sandbox.
env HOME=$WORK/home
env USERPROFILE=$WORK/home
env XDG_CACHE_HOME=$WORK/home/.cache
env LocalAppData=$WORK/home
env CODEX_HOME=
env COPILOT_HOME=
mkdir $WORK/home/.claude

# Only claude is detected: install lands exactly one target.
exec rancher skill install -o json
jsonquery stdout data.0.action changed
jsonquery stdout data.0.target.harness claude

# In sync right after install.
exec rancher skill status -o json
jsonquery stdout data.0.verdict in-sync

# A second install with the same content changes nothing.
exec rancher skill install -o json
jsonquery stdout data.0.action unchanged
jsonquery stdout data.0.verdict in-sync

# Tamper with an extra file -> modified, nonzero exit, rows still rendered.
cp extra.md $WORK/home/.claude/skills/rancher/extra.md
! exec rancher skill status -o json
jsonquery stdout data.0.verdict modified

# Repair, then remove.
exec rancher skill install -o json
jsonquery stdout data.0.action changed

# Uninstall prints only the columns it fills and removes the skills directory
# it emptied; status prints no ACTION column.
exec rancher skill uninstall
stdout 'HARNESS\s+SCOPE\s+ACTION\s+DETAIL'
! stdout VERDICT
! stdout VERSION
! exists $WORK/home/.claude/skills
exists $WORK/home/.claude
exec rancher skill status -o json
jsonquery stdout data.0.verdict absent
exec rancher skill status
stdout 'HARNESS\s+SCOPE\s+VERDICT\s+VERSION\s+DETAIL'
! stdout ACTION

# Fresh-machine shape: no harness homes -> empty report, exit 0, warning.
env HOME=$WORK/empty
env USERPROFILE=$WORK/empty
env XDG_CACHE_HOME=$WORK/empty/.cache
env LocalAppData=$WORK/empty
mkdir $WORK/empty
exec rancher skill status -o json
jsonquery stdout warnings.0 'no coding-agent harness detected; nothing to report'

-- extra.md --
tampered content
