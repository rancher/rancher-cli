env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# create project object; a fixed (non-generateName) name lands as the id.
exec rancher create project web --cluster testcluster --apply

# a display name resolves through the cluster's steve project collection: the
# fixture project p-empty is displayed as Empty and holds no namespace.
exec rancher get namespaces --project Empty --cluster testcluster -o json
jsonquery stdout 'data.#' 0

# a namespace born a member (create namespace --project) and a plain one.
exec rancher create namespace proj-ns-member --project web --cluster testcluster --apply
exec rancher create namespace proj-ns-other --cluster testcluster --apply
exec rancher create resource -f cm-member.yaml --cluster testcluster --apply
exec rancher create resource -f cm-other.yaml --cluster testcluster --apply

# list scoped to the project: only the member namespace's configmap comes back.
exec rancher get configmaps --cluster testcluster --project web -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.metadata.name proj-member-cm

# the same list as a text table: the member's row only, with the namespace
# column a list across namespaces has.
exec rancher get configmaps --cluster testcluster --project web
stdout 'NAMESPACE\s+NAME\s+DATA\s+AGE'
stdout 'proj-ns-member\s+proj-member-cm\s+'
! stdout 'proj-other-cm'

# named get of the non-member's configmap under --project → VALIDATION, never
# a silent no-op.
! exec rancher get configmap proj-other-cm --cluster testcluster --namespace proj-ns-other --project web
stderr 'error \(VALIDATION\):'

# a workspace-policy kind does not take --project: the pipeline refuses it
# before any request.
! exec rancher get gitrepos --project web
stderr 'error \(VALIDATION\): --project does not apply to get gitrepo'

# membership commands: add a second namespace, see it join the membership
# listing, then remove it again.
exec rancher create namespace proj-ns-second --cluster testcluster --apply
exec rancher project add-namespace proj-ns-second --project web --cluster testcluster --apply
exec rancher get namespaces --project web --cluster testcluster -o json
jsonquery stdout 'data.#' 2

# remove-namespace reads the project from the namespace's own annotation: a
# --project is refused, with the command to run instead.
! exec rancher project remove-namespace proj-ns-second --project web --cluster testcluster --apply -o json
jsonquery stderr data.error.code VALIDATION
jsonquery stderr data.error.message '--project does not apply to project remove-namespace'
jsonquery stderr data.error.hint 'rancher project remove-namespace ''proj-ns-second'' --cluster ''testcluster'' --dry-run'
exec rancher project remove-namespace proj-ns-second --cluster testcluster --apply
exec rancher get namespaces --project web --cluster testcluster -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.metadata.name proj-ns-member

# a namespace with the project label and no annotation is in no project: the
# listing leaves it out, and remove-namespace removes its label.
exec rancher create resource -f ns-with-project-label.yaml --cluster testcluster --apply
exec rancher get namespaces --project web --cluster testcluster -o json
jsonquery stdout 'data.#' 1
exec rancher project remove-namespace proj-ns-with-project-label --cluster testcluster --dry-run
stderr 'proj-ns-with-project-label is in no project; removing its project label'
exec rancher project remove-namespace proj-ns-with-project-label --cluster testcluster --apply
stdout 'namespace/proj-ns-with-project-label project label removed'
exec rancher get namespace proj-ns-with-project-label --cluster testcluster -o json
jsonquery stdout 'data.metadata.labels.field\.cattle\.io/projectId' ''

# root-position --project reaches usage via urfave lineage (usage's own
# local --project flag is gone).
# --project without --by returns member-namespace rows; rows derive from pods,
# so a pod-less project yields an empty map - the by discriminator still
# proves the project resolved and the namespace grouping ran.
exec rancher --project web usage --cluster testcluster -o json
jsonquery stdout data.by namespace

# the single-bucket form: --by project always seeds the named project's row,
# so a pod-less project reports zero requests.
exec rancher --project web usage --by project --cluster testcluster -o json
jsonquery stdout data.by project
jsonquery stdout data.rows.web.cpuRequest '0'

# inspect project: identity, member namespaces, quota, usage. envtest has no
# metrics-server, so the usage summary degrades to a warning (as every other
# metrics-joining composite does here) with prtb membership unaffected.
exec rancher inspect project web --cluster testcluster -o json
jsonquery stdout data.id web
jsonquery stdout 'data.namespaces.#' 1
jsonquery stdout data.namespaces.0.name proj-ns-member
jsonquery stdout 'data.members.#' 0
jsonquery stdout 'data.degraded.#' 1
jsonquery stdout data.degraded.0.section metrics
jsonquery stdout data.degraded.0.state unavailable
jsonquery stdout 'warnings.#' 1

# Quota flags on create project (mandatory-together, matching keys).
exec rancher create project web-quota --cluster testcluster --quota-limit limitsCpu=2,limitsMemory=4Gi --namespace-default-quota limitsCpu=1,limitsMemory=2Gi --apply
exec rancher get project web-quota --cluster testcluster -o json
jsonquery stdout data.spec.resourceQuota.limit.limitsCpu 2
jsonquery stdout data.spec.resourceQuota.limit.limitsMemory 4Gi
jsonquery stdout data.spec.namespaceDefaultResourceQuota.limit.limitsCpu 1
jsonquery stdout data.spec.namespaceDefaultResourceQuota.limit.limitsMemory 2Gi

# --container-default-resource-limit writes the flat ContainerResourceLimit.
exec rancher create project web-limit --cluster testcluster --container-default-resource-limit limitsCpu=100m,limitsMemory=64Mi,requestsCpu=50m,requestsMemory=32Mi --apply
exec rancher get project web-limit --cluster testcluster -o json
jsonquery stdout data.spec.containerDefaultResourceLimit.limitsCpu 100m
jsonquery stdout data.spec.containerDefaultResourceLimit.limitsMemory 64Mi
jsonquery stdout data.spec.containerDefaultResourceLimit.requestsCpu 50m
jsonquery stdout data.spec.containerDefaultResourceLimit.requestsMemory 32Mi

-- cm-member.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: proj-member-cm
  namespace: proj-ns-member
data:
  k: v

-- cm-other.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: proj-other-cm
  namespace: proj-ns-other
data:
  k: v

-- ns-with-project-label.yaml --
apiVersion: v1
kind: Namespace
metadata:
  name: proj-ns-with-project-label
  labels:
    field.cattle.io/projectId: web
