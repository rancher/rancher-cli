env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# VALIDATION: missing required arg
! exec rancher create project -o json
jsonquery stderr data.error.code VALIDATION

# AUTH: wrong token
env RANCHER_CLI_TOKEN=bad-token
! exec rancher get project nope --cluster testcluster -o json
jsonquery stderr data.error.code AUTH
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# NOT_FOUND: absent resource
! exec rancher get project does-not-exist --cluster testcluster -o json
jsonquery stderr data.error.code NOT_FOUND

# VALIDATION: unknown top-level command, via our CommandNotFound hook, not
# urfave's own unhinted "No help topic" exit 3
! exec rancher bogus-command-xyz -o json
jsonquery stderr data.error.code VALIDATION
stderr 'rancher schema'

# VALIDATION: unknown kind under a group, same hook, same exit code
! exec rancher get bogus-kind-xyz -o json
jsonquery stderr data.error.code VALIDATION
stderr 'rancher schema'

# VALIDATION: an unknown command name is reported before the flags after it
! exec rancher create roletemplate test-rt --context cluster -o json
jsonquery stderr data.error.code VALIDATION
jsonquery stderr data.error.message 'unknown command "roletemplate"'

# -o yaml renders the same structured error envelope as -o json, serialized
# as YAML - not JSON dressed up as one.
! exec rancher get project definitely-absent --cluster testcluster -o yaml
stderr 'code: NOT_FOUND'
stderr 'kind: Error'

# -o table (and every other non-json/non-yaml format) renders the short
# operator-facing text form instead of an envelope.
! exec rancher get project definitely-absent --cluster testcluster -o table
stderr 'error \(NOT_FOUND\):'
! stderr 'apiVersion'

# NOT_LOGGED_IN: a generated command with no stored login and no env
# override must not surface as an unhinted GENERIC
env RANCHER_CLI_URL=
env RANCHER_CLI_TOKEN=
! exec rancher get clusters -o json
jsonquery stderr data.error.code NOT_LOGGED_IN
stderr 'auth login'
env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN
