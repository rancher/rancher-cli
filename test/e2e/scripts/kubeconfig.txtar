# kubeconfig must work from an env-only session too (no stored
# context) - a fresh --config dir proves it, since every other e2e case in
# this script shares RANCHER_CLI_CONFIG_DIR with the auth-login below.
mkdir envonly
env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN
exec rancher --config envonly kubeconfig --cluster testcluster
cp stdout kc-env.yaml
jsonquery -yaml kc-env.yaml clusters.0.cluster.server $TEST_RANCHER_URL/k8s/clusters/c-test
jsonquery -yaml kc-env.yaml users.0.user.exec.apiVersion client.authentication.k8s.io/v1beta1
env RANCHER_CLI_URL=
env RANCHER_CLI_TOKEN=

stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin

exec rancher kubeconfig --cluster testcluster
cp stdout kc.yaml
jsonquery -yaml kc.yaml clusters.0.cluster.server $TEST_RANCHER_URL/k8s/clusters/c-test
jsonquery -yaml kc.yaml users.0.user.exec.apiVersion client.authentication.k8s.io/v1beta1
jsonquery -yaml kc.yaml users.0.user.exec.command rancher
jsonquery -yaml kc.yaml users.0.user.exec.args.6 --name

-- token.txt --
e2e:secret

# Authorized Cluster Endpoint: an fqdn cluster carries one direct context,
# <entry>-fqdn, current, on the shared exec user entry, with the endpoint's
# CA; the exec block asks kubectl for the invoking context's cluster entry.
exec rancher kubeconfig --cluster acefqdn
cp stdout kc-fqdn.yaml
! stderr .
jsonquery -yaml kc-fqdn.yaml current-context e2e-c-ace-fqdn-fqdn
jsonquery -yaml kc-fqdn.yaml 'clusters.#(name=="e2e-c-ace-fqdn-fqdn").cluster.server' https://ace.example.test
jsonquery -yaml kc-fqdn.yaml 'clusters.#(name=="e2e-c-ace-fqdn").cluster.server' $TEST_RANCHER_URL/k8s/clusters/c-ace-fqdn
jsonquery -yaml kc-fqdn.yaml 'contexts.#(name=="e2e-c-ace-fqdn-fqdn").context.user' e2e-c-ace-fqdn
jsonquery -yaml kc-fqdn.yaml users.0.name e2e-c-ace-fqdn
jsonquery -yaml kc-fqdn.yaml users.0.user.exec.provideClusterInfo true
stdout 'certificate-authority-data'

# Without an fqdn: one direct context per control-plane node at
# https://<address>:6443, the worker skipped, the first Ready node current.
exec rancher kubeconfig --cluster acenodes
cp stdout kc-nodes.yaml
! stderr .
jsonquery -yaml kc-nodes.yaml current-context e2e-c-ace-nodes-cp2
jsonquery -yaml kc-nodes.yaml 'clusters.#(name=="e2e-c-ace-nodes-cp1").cluster.server' https://10.0.0.1:6443
jsonquery -yaml kc-nodes.yaml 'clusters.#(name=="e2e-c-ace-nodes-cp2").cluster.server' https://10.0.0.2:6443
jsonquery -yaml kc-nodes.yaml 'contexts.#(name=="e2e-c-ace-nodes-cp1").context.user' e2e-c-ace-nodes
! stdout 'e2e-c-ace-nodes-w1'
jsonquery -yaml kc-nodes.yaml users.0.user.exec.provideClusterInfo true

# The endpoint enabled but no control-plane node: today's proxy-only file,
# no provideClusterInfo, and exactly one notice naming the reason.
exec rancher kubeconfig --cluster aceempty
cp stdout kc-empty.yaml
stderr 'direct endpoint contexts omitted: no control-plane node'
jsonquery -yaml kc-empty.yaml current-context e2e-c-ace-empty
! stdout provideClusterInfo

# A cluster without the endpoint is unchanged: one context, no notice.
exec rancher kubeconfig --cluster testcluster
! stderr .
! stdout provideClusterInfo
