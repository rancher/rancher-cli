# A kubeconfig records its config directory: written with a relative
# --config, it authenticates through that directory, with that
# directory's store, from any working directory and whatever kubectl's
# environment names - the variable cleared, or pointed at an empty
# directory with RANCHER_CLI_CREDENTIAL_STORE naming another store. The
# first kubectl call runs cold, from acct's stored login; the second is
# served from acct's cache.
[!kubectl] skip 'kubectl not on PATH'

mkdir acct
env RANCHER_CLI_CONFIG_DIR=
stdin token.txt
exec rancher --config acct auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin

exec rancher --config acct kubeconfig --cluster testcluster
cp stdout kc.yaml
jsonquery -yaml kc.yaml users.0.user.exec.env.0.value $WORK${/}acct
jsonquery -yaml kc.yaml users.0.user.exec.env.1.value ''
stderr '^this kubeconfig records this machine''s config directory .*acct; it works for this user on this machine only$'

mkdir elsewhere
cd elsewhere
exec kubectl --kubeconfig ../kc.yaml get namespaces
stdout default

mkdir empty
env RANCHER_CLI_CONFIG_DIR=$WORK${/}elsewhere${/}empty
env RANCHER_CLI_CREDENTIAL_STORE=keychain
exec kubectl --kubeconfig ../kc.yaml get namespaces
stdout default

-- token.txt --
e2e:secret
