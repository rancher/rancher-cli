env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# cattle-system is seeded by the harness (TestMain) - the logs and
# support-bundle target tables both hardcode it. Targets webhook (not
# agent): scripts run concurrently against one shared apiserver, and
# logs-target.txtar owns the app=cattle-cluster-agent selector - a second
# pod under that same selector would make ITS pod count assertion flaky.
exec rancher create resource -f webhook-pod.yaml --cluster local --apply

exec rancher support-bundle --targets webhook --clusters local --output-file bundle.tar.gz -o json
jsonquery stdout data.path bundle.tar.gz

exec tar -tzf bundle.tar.gz
stdout 'manifest\.json'
stdout 'logs/'
stdout 'clusters/'

# the archive writer is O_CREATE|O_EXCL - the same --output-file path must be
# refused, never truncated, on a second run.
! exec rancher support-bundle --targets webhook --clusters local --output-file bundle.tar.gz -o json
jsonquery stderr data.error.code VALIDATION

# --output-file - is refused: the archive goes to a file, never to stdout.
! exec rancher support-bundle --targets webhook --clusters local --output-file - -o json
jsonquery stderr data.error.code VALIDATION
! exists -
! exec rancher support-bundle --targets webhook --clusters local --output-file=- -o json
jsonquery stderr data.error.code VALIDATION
! exists -

# -f is not a support-bundle flag: it is refused as unknown and writes nothing.
! exec rancher support-bundle --targets webhook --clusters local -f other.tar.gz -o json
jsonquery stderr data.error.code VALIDATION
! exists other.tar.gz

# a server that answers nothing: no item is collected and the command fails
# with the code of the failed requests; it keeps the archive, whose manifest
# lists each failure. The dial error text differs per operating system; the
# check reads the code only. This is the last step: env persists.
env RANCHER_CLI_URL=https://127.0.0.1:1
! exec rancher support-bundle --targets webhook --clusters local --output-file none.tar.gz -o json
jsonquery stderr data.error.code GENERIC
exists none.tar.gz

-- webhook-pod.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: webhook-pod
  namespace: cattle-system
  labels:
    app: rancher-webhook
spec:
  containers:
    - name: rancher-webhook
      image: busybox
