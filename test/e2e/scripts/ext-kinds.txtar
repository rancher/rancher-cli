env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# NSNone + Scope Management: the empty-version ext.cattle.io kinds route to
# LOCAL unconditionally - no --cluster flag is even generated (Downstream-only
# per getFlags), so this alone proves routing never touches a --cluster target.
exec rancher get tokens -o json
jsonquery stdout 'data.#' 0

# A manifest cannot create a token: `create token` does, and shows its value
# once. The scenario seeds its own token with it; the facade names the token
# and takes the user from the caller, so the name is read from the result.
! exec rancher create resource -f token.yaml --apply --yes
stderr 'error \(VALIDATION\):'
stderr 'cannot create a token from a manifest; create tokens with'
exec rancher create token --description ext-kinds-token-desc --apply --yes -o json
jsonget stdout data.name tkname.txt
setenvfrom TKNAME tkname.txt

exec rancher get token $TKNAME -o json
jsonquery stdout data.spec.description ext-kinds-token-desc

exec rancher delete token $TKNAME --apply --yes

exec rancher get kubeconfigs -o json

# Unlike tokens (facade-instance-local; the derived-create path never
# touches envtest), kubeconfig's list is NOT asserted empty here:
# create-kubeconfig.txtar's own scenario persists a real named copy via
# the facade's forwardNamedCreate (so a get/delete by the generated name
# works end to end), and testscript scenarios share one envtest cluster
# and run concurrently - the same reason the Feature list below is not
# asserted empty either. A manifest cannot create a kubeconfig either:
# `create kubeconfig` does. This scenario seeds its own copy and finds it
# by its own description, never by another scenario's object.
! exec rancher create resource -f kubeconfig.yaml --apply --yes
stderr 'error \(VALIDATION\):'
stderr 'cannot create a kubeconfig from a manifest; create kubeconfigs with'
exec rancher create kubeconfig --clusters testcluster --description ext-kinds-kubeconfig-desc --apply --yes
exec rancher get kubeconfigs -o json
jsonget stdout 'data.#(spec.description=="ext-kinds-kubeconfig-desc").metadata.name' kcname.txt
setenvfrom KCNAME kcname.txt

exec rancher get kubeconfig $KCNAME -o json
jsonquery stdout data.spec.description ext-kinds-kubeconfig-desc

exec rancher delete kubeconfig $KCNAME --apply --yes

# feature (management.cattle.io/v3, NSNone/Management, Deletable: false): the
# generic `get`/`patch` pair, no `delete` generated. Feature's interesting
# fields are set by Rancher's own controller (status.value/default/
# lockedValue), which this harness does not emulate. The list is NOT
# asserted empty: testscript scenarios share one envtest cluster and run
# concurrently, and oidc-client-secrets.txtar legitimately seeds a real
# "oidc-provider" Feature to exercise Prime-capability gating end to end -
# a fixed, production-real name that cannot be scenario-namespaced the way
# ordinary test objects are.
exec rancher get features -o json

# PRIME-ONLY renders the wire's status.prime classification, never
# server-edition detection; the column header must appear regardless of
# how many Features exist.
exec rancher get features
stdout PRIME-ONLY

-- token.yaml --
apiVersion: ext.cattle.io/v1
kind: Token
metadata:
  name: ext-kinds-token
spec:
  userID: u-ext-1
  description: ext-kinds-token-desc
-- kubeconfig.yaml --
apiVersion: ext.cattle.io/v1
kind: Kubeconfig
metadata:
  name: ext-kinds-kubeconfig
spec:
  description: ext-kinds-kubeconfig-desc
