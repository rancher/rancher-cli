env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# The node driver Rancher ships for Harvester, with the credential annotations
# the create reads.
exec rancher create resource -f nodedriver.yaml --apply --yes

# The Harvester recipe of REFERENCE.md: a kubeconfig without the server's
# default entry, piped into the credential create. A txtar has no shell pipe,
# so the output of the first command is a file that the second reads on stdin.
# The facade numbers the kubeconfigs of each scenario from 1 and every scenario
# stores them in one cluster: a preview first moves the name of this one past 2,
# which ext-kinds takes, and the copy is deleted below. The description marks
# this scenario's kubeconfig, so that the lookup below never finds another.
exec rancher create kubeconfig --clusters c-test --include-default-entry false --dry-run
exec rancher create kubeconfig --clusters c-test --include-default-entry false --description e2e-harvester-recipe --apply --yes
cp stdout kc.yaml

stdin kc.yaml
exec rancher create cloud-credential harvester harvester-cc --set clusterId=c-test --from-file kubeconfigContent=- --apply
stdout harvester-cc
stdout harvester

# The kubeconfig was created without the default entry.
exec rancher get kubeconfigs -o json
jsonget stdout 'data.#(spec.description=="e2e-harvester-recipe").metadata.name' kcname.txt
setenvfrom KCNAME kcname.txt
exec rancher get kubeconfig $KCNAME -o json
jsonquery stdout data.spec.includeDefaultEntry false

# The copy is deleted so that no other scenario finds it.
exec rancher delete kubeconfig $KCNAME --apply --yes

# The credential is readable after the create.
exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(displayName=="harvester-cc").driver' harvester

-- nodedriver.yaml --
apiVersion: management.cattle.io/v3
kind: NodeDriver
metadata:
  name: harvester
  annotations:
    publicCredentialFields: clusterType,clusterId
    privateCredentialFields: kubeconfigContent
    optionalCredentialFields: clusterId
    defaults: clusterType:imported
spec:
  displayName: harvester
  active: true
  builtin: true
  addCloudCredential: true
