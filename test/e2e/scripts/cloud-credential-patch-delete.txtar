env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# The credential this scenario changes. The facade names it, so every command
# that changes it takes the id from the create's result.
exec rancher create cloud-credential s3 e2e-cc-s2 --set accessKey=AKIAEXAMPLE --from-file secretKey=secret-key.txt --apply -o json
jsonquery stdout 'data.0.displayName' e2e-cc-s2
jsonget stdout data.0.id ccid.txt
setenvfrom CCID ccid.txt

# A display name does not select a credential in a command that changes it.
! exec rancher patch cloud-credential e2e-cc-s2 --description 'second description' --dry-run -o json
jsonquery stderr data.error.code NOT_FOUND

# A preview reads the credential, says it comes from server reads, and changes nothing.
exec rancher patch cloud-credential $CCID --description 'second description' --dry-run -o json
jsonquery stdout kind Effect
jsonquery stdout data.action update
jsonquery stdout data.previewSource serverReads
jsonquery stdout data.conflictDetection false
jsonquery stdout data.destructive false

# A patch of the description needs --apply and no --yes.
exec rancher patch cloud-credential $CCID --description 'second description' --apply -o json
jsonquery stdout 'data.0.displayName' e2e-cc-s2
jsonquery stdout 'data.0.driver' s3

# The display name is the change a script can see: the row shows no description or secret.
exec rancher patch cloud-credential $CCID --display-name e2e-cc-s2-renamed --apply -o json
jsonquery stdout 'data.0.displayName' e2e-cc-s2-renamed
exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(displayName=="e2e-cc-s2-renamed").driver' s3
jsonquery stdout 'data.#(displayName=="e2e-cc-s2")#.displayName' '[]'

# Replacing a secret value needs --yes; without it nothing is sent.
! exec rancher patch cloud-credential $CCID --from-file secretKey=new-secret-key.txt --apply -o json
jsonquery stderr data.error.code CONFIRMATION_REQUIRED
exec rancher patch cloud-credential $CCID --from-file secretKey=new-secret-key.txt --apply --yes -o json
jsonquery stdout 'data.0.displayName' e2e-cc-s2-renamed

# The patch document flags are refused with a pointer to its own flags.
! exec rancher patch cloud-credential $CCID --patch '{}' -o json
jsonquery stderr data.error.code VALIDATION

# A delete takes the id too: the new display name selects nothing.
! exec rancher delete cloud-credential e2e-cc-s2-renamed --dry-run -o json
jsonquery stderr data.error.code NOT_FOUND

# A delete preview names the credential, says it comes from server reads and sends nothing.
exec rancher delete cloud-credential $CCID --dry-run -o json
jsonquery stdout kind Effect
jsonquery stdout data.action delete
jsonquery stdout data.previewSource serverReads
jsonquery stdout data.destructive true
exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(displayName=="e2e-cc-s2-renamed").driver' s3

# A delete needs --yes; without it nothing is sent.
! exec rancher delete cloud-credential $CCID --apply -o json
jsonquery stderr data.error.code CONFIRMATION_REQUIRED

# With --apply --yes the credential is deleted and the command waits until it is gone.
exec rancher delete cloud-credential $CCID --apply --yes -o json
jsonquery stdout 'data.0.displayName' e2e-cc-s2-renamed
exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(displayName=="e2e-cc-s2-renamed")#.displayName' '[]'
jsonquery stdout 'data.#(displayName=="e2e-cc-s2")#.displayName' '[]'

-- secret-key.txt --
fake-secret-key-value-0001
-- new-secret-key.txt --
fake-secret-key-value-0002
