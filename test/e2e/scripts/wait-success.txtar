env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

exec rancher create resource -f gitrepo.yaml --apply

# the shim has seen the watch open before the object changes, so the wait ends by an event
exec rancher get gitrepo waiter --wait --timeout 30s -o json &watchedcmd&
waitwatchopen waiter
flipstatus local fleet.cattle.io/v1alpha1/gitrepos fleet-default waiter {"conditions":[{"type":"Ready","status":"True"}]}
wait watchedcmd
stdout 'Ready'
! stderr .
shimwaits waiter 1 1 200 200

# the only line on stderr is the warning that the wait was satisfied soon after the object was created
exec rancher get gitrepo waiter --wait --timeout 5s
stdout 'wait: condition=Ready satisfied after'
stderr '\A# warning: wait satisfied [^\n]* after creation[^\n]*\n\z'
# a List that finds the object satisfied opens no watch
shimwaits waiter 2 1 200 200

-- gitrepo.yaml --
apiVersion: fleet.cattle.io/v1alpha1
kind: GitRepo
metadata:
  name: waiter
  namespace: fleet-default
spec:
  repo: https://example.com/repo.git
