# This script sticks to the WARM exec-credential cache path via
# seedexeccache; kubectl-interop-cold.txtar covers the cold round trip
# through the facade's /v1-public/* endpoints and the ext.cattle.io/v1
# token create instead (the facade is a separate layer composed in front of
# the unchanged router).
# seedexeccache pre-warms the cache through the real config store API, so
# get-token takes its cache fast-path here without touching login at all.
[!kubectl] skip 'kubectl not on PATH'

stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin

seedexeccache e2e-c-test c-test

# The seeded record is the one the exec plugin serves for the entry the
# --name identifies: the token comes from the cache, not from a token
# created from the stored login.
exec rancher auth get-token --server $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --cluster c-test --name e2e-c-test
jsonquery stdout status.token e2e:secret

exec rancher kubeconfig --cluster testcluster
cp stdout kc.yaml

exec kubectl --kubeconfig kc.yaml get namespaces
stdout default

-- token.txt --
e2e:secret
