env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# A public field is a --set value; the secret comes from a file.
exec rancher create cloud-credential s3 e2e-new --set accessKey=AKIAEXAMPLE --from-file secretKey=secret-key.txt --dry-run -o json
jsonquery stdout kind Effect
jsonquery stdout data.previewSource serverReads
jsonquery stdout data.conflictDetection false

# --dry-run created nothing.
exec rancher get cloud-credential -o json
! stdout 'e2e-new'

# A secret field in --set is refused and nothing is sent.
! exec rancher create cloud-credential s3 e2e-new --set accessKey=a --set secretKey=b --dry-run -o json
jsonquery stderr data.error.code VALIDATION

exec rancher create cloud-credential s3 e2e-new --set accessKey=AKIAEXAMPLE --from-file secretKey=secret-key.txt --apply -o json
jsonquery stdout 'data.0.displayName' e2e-new
jsonquery stdout 'data.0.driver' s3

exec rancher get cloud-credential -o json
jsonquery stdout 'data.#(displayName=="e2e-new").driver' s3

-- secret-key.txt --
fake-secret-key-value-0001
