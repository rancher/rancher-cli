# bare schema is the TOC: orientation, not the manifest
exec rancher schema -o json
cp stdout toc.json
jsonquery toc.json 'data.commandCount' 227
jsonquery toc.json 'data.kindCount' 60
jsonquery toc.json 'data.kinds.#' 60
# generated get/patch/delete <kind> commands are COLLAPSED on the bare
# TOC - assert a NON-generated command's group entry and the collapsed count
# (verify both actual values when writing this, like every count pin)
jsonquery toc.json 'data.groups.#(name="auth").commands.0.name' 'auth login'
jsonquery toc.json 'data.generatedCommandCount' 158
# global contracts are disclosed on the bare TOC: the exit map and the
# Effect contract - an agent parses --dry-run output without --all
jsonquery toc.json 'data.effectSchema.actions.#' 3
jsonquery toc.json 'data.effectSchema.fields.#(name="resourceVersion").type' string

# the full manifest is explicit: --all
exec rancher schema --all -o json
cp stdout schema.json
jsonquery schema.json 'data.commands.#' 227
jsonquery schema.json data.effectSchema.actions.0 create
jsonquery schema.json 'data.commands.#(name="delete project").destructive' true
jsonquery schema.json 'data.commands.#(name="get pod").aliases.0' pods
jsonquery schema.json 'data.errorCodes.#' 19
jsonquery schema.json 'data.errorCodes.#(code="AUTH").exit' 3
jsonquery schema.json 'data.errorCodes.#(code="CREDENTIAL_STORE_UNAVAILABLE").exit' 14

# --all conflicts with narrowing
! exec rancher schema get pod --all -o json
jsonquery stderr data.error.code VALIDATION

# Per-command selection is the flattened card (no commands array,
# no kinds)
exec rancher schema get pod -o json
cp stdout one.json
jsonquery one.json data.name 'get pod'
jsonquery one.json 'data.kinds.#' ''
jsonquery one.json 'data.commands.#' ''

# Quoted single-token selector - one argv token must behave like
# two unquoted tokens; the schema command joins args before matching.
exec rancher schema 'get pod' -o json
jsonquery stdout data.name 'get pod'

# schema takes at most two words: a third is refused before any lookup
! exec rancher schema get auth login -o json
jsonquery stderr data.error.code VALIDATION
jsonquery stderr data.error.message 'schema takes at most 2 arguments ([command] [subcommand]); unexpected argument ''login'''
jsonquery stderr data.error.hint 'rancher schema --help'

! exec rancher schema get nonsense -o json
jsonquery stderr data.error.code VALIDATION
