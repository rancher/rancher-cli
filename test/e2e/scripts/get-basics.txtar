env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

exec rancher create resource -f cm.yaml --cluster testcluster --apply

exec rancher get configmaps --cluster testcluster --namespace default
stdout basics-cm

exec rancher get configmaps --cluster testcluster --namespace default -o name
stdout basics-cm

exec rancher get configmap basics-cm --cluster testcluster --namespace default -o yaml
cp stdout cm.out.yaml
jsonquery -yaml cm.out.yaml data.metadata.name basics-cm

exec rancher get cm basics-cm --cluster testcluster --namespace default -o json
jsonquery stdout data.metadata.name basics-cm

# The served object really carries managedFields (positive
# precondition - without it the absence assertions below are vacuous) ...
rawget core/v1/configmaps default basics-cm cm.raw.json
! jsonquery cm.raw.json metadata.managedFields ''

# ... and the CLI's structured output omits it (-yaml: the file is YAML;
# without the flag gjson silently returns empty on YAML input and the
# assertion is vacuous).
jsonquery -yaml cm.out.yaml data.metadata.managedFields ''
exec rancher get cm basics-cm --cluster testcluster --namespace default -o json
jsonquery stdout data.metadata.managedFields ''

# --selector is applied by the server: the labeled configmap is in the
# filtered list, a non-matching selector lists nothing, a malformed selector
# and a selector with a name are refused before any request.
exec rancher get configmaps --cluster testcluster --namespace default --selector app=basics -o json
jsonquery stdout 'data.#(metadata.name=="basics-cm").metadata.name' basics-cm
exec rancher get configmaps --cluster testcluster --namespace default -l app=nomatch -o json
jsonquery stdout 'data.#' 0
! exec rancher get configmaps --cluster testcluster --namespace default --selector 'app in (web' -o json
jsonquery stderr data.error.code VALIDATION
! exec rancher get cm basics-cm --cluster testcluster --namespace default --selector app=basics -o json
jsonquery stderr data.error.code VALIDATION

-- cm.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: basics-cm
  namespace: default
  labels:
    app: basics
data:
  foo: bar
