env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

exec rancher create project members-proj --cluster testcluster --apply

# the fallback backing namespace IS the project id; it must EXIST before a
# PRTB create can succeed - the harness runs no Rancher controllers.
exec rancher create namespace members-proj --cluster local --apply

# seed a user fixture: Sensitive-kind creates need --apply --yes.
exec rancher create resource -f user.yaml --apply --yes

# regression: users are a flat/norman-style kind (root-level displayName,
# principalIds - not spec-nested); root fields must round-trip through the
# CRD fixture like the real API.
exec rancher get user u-alice -o json
jsonquery stdout data.displayName alice
jsonquery stdout 'data.principalIds.0' local://u-alice

# bad role pre-flight: NOT_FOUND before any binding is attempted.
! exec rancher grant alice --role no-such-role --project members-proj --cluster testcluster --dry-run -o json
jsonquery stderr data.error.code NOT_FOUND
jsonquery stderr data.error.hint 'rancher get roletemplates'
# a needle with no substring overlap must still carry at-scope candidates:
# assert the first candidate's id is non-empty (stable regardless of list order).
! jsonquery stderr data.error.candidates.0.id ''

# grant dry-run preview: effect carries action + target prefix.
exec rancher grant alice --role project-member --project members-proj --cluster testcluster --dry-run -o json
jsonquery stdout data.action create
stdout projectroletemplatebindings/project-member-

exec rancher grant alice --role project-member --project members-proj --cluster testcluster --apply --yes

# the binding carries BOTH userName and userPrincipalName from the one
# resolved user (no orphan user is created, unlike Rancher's EnsureUser).
exec rancher get prtb --namespace members-proj -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.userName u-alice
jsonquery stdout data.0.userPrincipalName local://u-alice
jsonquery stdout data.0.roleTemplateName project-member
jsonquery stdout data.0.projectName c-test:members-proj

# the default table now carries MEMBER/ROLE/PROJECT (members ergonomics).
exec rancher get prtb --namespace members-proj
stdout 'MEMBER'
stdout 'ROLE'
stdout 'PROJECT'
stdout 'u-alice'
stdout 'project-member'
stdout 'c-test:members-proj'

# crtb table: MEMBER/ROLE/CLUSTER through the cluster-scope grant path.
exec rancher grant alice --role cluster-member --cluster testcluster --apply --yes
exec rancher get crtb --cluster testcluster
stdout 'MEMBER'
stdout 'ROLE'
stdout 'CLUSTER'
stdout 'u-alice'
stdout 'cluster-member'
stdout 'c-test'

# revoke is destructive: --apply alone is refused.
! exec rancher revoke alice --project members-proj --cluster testcluster --apply
stderr 'error \(CONFIRMATION_REQUIRED\):'
stderr 're-run with --yes'

exec rancher revoke alice --project members-proj --cluster testcluster --apply --yes

exec rancher get prtb --namespace members-proj -o json
jsonquery stdout 'data.#' 0

# grant with an unknown FQ principal: provisioning path preview + create.
# A subject with no matching user record forces a userPrincipalName-only
# binding; the dry-run preview warns about the predicted EnsureUser id
# (u-pu7rxaxkea for okta_user://unknown-user-xyz).
exec rancher grant okta_user://unknown-user-xyz --role project-member --project members-proj --cluster testcluster --dry-run -o json
jsonquery stdout data.action create
stdout 'will provision user.*u-pu7rxaxkea'

exec rancher grant okta_user://unknown-user-xyz --role project-member --project members-proj --cluster testcluster --apply --yes

exec rancher get prtb --namespace members-proj -o json
jsonquery stdout 'data.#' 1
jsonquery stdout data.0.userPrincipalName okta_user://unknown-user-xyz
jsonquery stdout data.0.userName ''

exec rancher revoke okta_user://unknown-user-xyz --project members-proj --cluster testcluster --apply --yes

exec rancher get prtb --namespace members-proj -o json
jsonquery stdout 'data.#' 0

# inspect project default card: sections + a display-name-resolved member,
# and the shared memberRow JSON contract (principal/role/binding, displayName added).
exec rancher grant alice --role project-member --project members-proj --cluster testcluster --apply --yes
exec rancher inspect project members-proj --cluster testcluster
stdout 'PROJECT'
stdout 'NAMESPACES'
stdout 'MEMBERS'
stdout 'RESOURCE QUOTA'
stdout 'USAGE'
stdout 'alice \(local://u-alice\)  project-member'

exec rancher inspect project members-proj --cluster testcluster -o json
jsonquery stdout 'data.members.#' 1
jsonquery stdout data.members.0.principal local://u-alice
jsonquery stdout data.members.0.role project-member
jsonquery stdout data.members.0.displayName alice
! jsonquery stdout data.members.0.binding ''

# inspect cluster MEMBERS section + additive JSON member shape.
exec rancher inspect cluster testcluster
stdout 'MEMBERS'
stdout 'alice \(local://u-alice\)  cluster-member'

exec rancher inspect cluster testcluster -o json
jsonquery stdout 'data.members.#(principal=="local://u-alice").principal' local://u-alice
jsonquery stdout 'data.members.#(principal=="local://u-alice").displayName' alice
jsonquery stdout 'data.members.#(principal=="local://u-alice").role' cluster-member
! jsonquery stdout 'data.members.#(principal=="local://u-alice").binding' ''

-- user.yaml --
apiVersion: management.cattle.io/v3
kind: User
metadata:
  name: u-alice
displayName: alice
username: alice
principalIds:
  - local://u-alice
