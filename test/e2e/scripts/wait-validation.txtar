env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# --for alone starts the wait, which finds no such pod
! exec rancher get pod whatever --for state=x --cluster testcluster --namespace default
stderr 'error \(NOT_FOUND\):'

# --timeout alone starts the wait, which finds no such pod
! exec rancher get pod whatever --timeout 1s --cluster testcluster --namespace default
stderr 'error \(NOT_FOUND\):'

# --wait=false conflicts with --for
! exec rancher get pod whatever --wait=false --for state=x --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# --wait=false conflicts with --timeout
! exec rancher get pod whatever --wait=false --timeout 1s --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# --wait on a list (no name)
! exec rancher get statefulset --wait --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# bare --wait on a kind with no default wait condition
! exec rancher get statefulset whatever --wait --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'

# --for grammar is rejected (not JSONPath, not a bare word)
! exec rancher get pod whatever --for garbage --cluster testcluster --namespace default
stderr 'error \(VALIDATION\):'
