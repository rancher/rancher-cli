# auth login against a server that advertises a provider this CLI cannot log
# in with (githubProvider, a code-exchange provider whose secret the server
# holds): naming that auth config is refused and names it and the server
# change requested, a miss names it too, the candidates stay the supported
# auth configs, and --auth-provider accepts an auth config's name.

! exec rancher auth login gh --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider github --no-input -o json
jsonquery stderr data.error.code NOT_FOUND
stderr '--auth-provider github names an auth config this CLI cannot sign in with; advertised by the server but not supported by this CLI: githubProvider \(server change requested: rancher/rancher#57034\)'
jsonquery stderr 'data.error.candidates.#(id=="local").id' local

! exec rancher auth login gh --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider nosuch --no-input -o json
jsonquery stderr data.error.code NOT_FOUND
stderr '--auth-provider nosuch matches no auth config this CLI can sign in with on this server; advertised by the server but not supported by this CLI: githubProvider \(server change requested: rancher/rancher#57034\)'
# candidates are the supported auth configs only (the harness advertises local
# and the facade's azuread); the unsupported one is named in the message, never offered
jsonquery stderr 'data.error.candidates.#(id=="local").id' local
! jsonquery stderr 'data.error.candidates.#(id=="github").id' github

# the auth config name "local" reaches the local flow, which then needs a terminal
! exec rancher auth login loc --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider local --no-input -o json
jsonquery stderr data.error.code AUTH
stderr 'interactive login required for auth config local'
