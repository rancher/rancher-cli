# The keychain probe below can hang indefinitely under testscript's sandboxed
# HOME on macOS (no usable keychain session for `security` to talk to).
# Skipping here keeps coverage on Linux/CI, where an unusable keyring fails
# fast instead of hanging.
[darwin] skip 'keychain probe hangs under the testscript HOME sandbox'

# Windows always exposes a usable native credential store (wincred), so the
# plaintext-fallback branch this script asserts can never run there. The
# usable-branch coverage is TestLoginSequenceFreshAutoUsableKeychain, the
# same compensating unit test the darwin skip leans on.
[windows] skip 'wincred is always usable, so auto never falls back to file'

# Clears Setup's RANCHER_CLI_CREDENTIAL_STORE=file default so the
# "auto" pin path actually runs - a script-side exemption since
# testscript.Env carries no script name for Setup to special-case.
env RANCHER_CLI_CREDENTIAL_STORE=

# Headless is the ONLY environment this script runs in (see the darwin skip),
# so the auto probe always fails fast here: expect the "file" pin and the
# plaintext-fallback notice - NOT the usable-branch "pinned credential store:
# keychain" notice, which needs a real keychain session no CI/container has.
# The usable branch's coverage is the unit test
# TestLoginSequenceFreshAutoUsableKeychain plus interactive macOS use.
stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin
stderr 'keychain unavailable; credentials will be stored in plaintext'
exists $RANCHER_CLI_CONFIG_DIR/credstore-pin
grep '^file$' $RANCHER_CLI_CONFIG_DIR/credstore-pin

exec rancher config list-servers
stdout 'NAME'
stdout 'e2e'
! stderr 'keychain unavailable'
! stderr 'pinned credential store:'

-- token.txt --
e2e:secret
