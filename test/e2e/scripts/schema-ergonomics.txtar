# The plain-text schema views ARE the operator contract under the default
# format - this scenario string-matches stdout on purpose (the one place
# that is correct); structured shapes stay with schema.txtar's jsonquery.

# A destructive mutating command's card renders the contract line
# and the --apply --yes gate line
exec rancher schema patch setting
stdout '(?m)^contract: mutating · internal · beta · destructive=true · server=write · auth$'
stdout '(?m)^gates: --apply --yes$'

# The kind card shows the effective verb surface, including the CRT
# patch refusal with its note
exec rancher schema clusterregistrationtoken
stdout '(?m)^kind: clusterregistrationtoken$'
stdout '(?m)^  patch: refused - read-only: the CLI only reads it, never edits it$'

# --search finds matches and exits 0
exec rancher schema --search kubeconfig
stdout 'commands match --search "kubeconfig"'
stdout '(?m)^  create kubeconfig - '

# Zero hits print the no-matches message naming the filter, exit 0
exec rancher schema --search zzz-no-such-term
stdout 'no commands match --search "zzz-no-such-term"'

# A command/kind collision resolves as the command card, footnoting
# the way to see the kind; --kind forces the kind card
exec rancher schema kubeconfig
stdout '(?m)^rancher kubeconfig$'
stdout '(?m)^to see this name as a kind, run: rancher schema kubeconfig --kind$'
exec rancher schema kubeconfig --kind
stdout '(?m)^kind: kubeconfig$'
stdout '(?m)^  get: available \(public · stable\)$'
