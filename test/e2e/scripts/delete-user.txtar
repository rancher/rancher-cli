env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

# Seed a user fixture: Sensitive-kind creates need --apply --yes.
exec rancher create resource -f user.yaml --apply --yes

# Verify the seeded user is visible.
exec rancher get user u-e2e -o json
jsonquery stdout data.metadata.name u-e2e
jsonquery stdout data.displayName e2euser

# Dry-run: the envelope carries the cascade warning (role bindings cascade).
# The self-delete guard runs pre-Plan (before the server dry-run). The envtest
# harness has no SelfUser store so the probe returns NOT_FOUND - endpoint
# absent, guard skips - and the inner Plan proceeds unchanged.
exec rancher delete user u-e2e --dry-run -o json
jsonquery stdout data.action delete
jsonquery stdout warnings.0 'deleting this user deletes the User object; Rancher''s controllers also delete the user''s role bindings (cluster memberships, project memberships, global role bindings)'

# Gate: --apply alone is refused because delete is destructive (needs --yes).
! exec rancher delete user u-e2e --apply -o json
jsonquery stderr data.error.code CONFIRMATION_REQUIRED
jsonquery stderr data.error.message 'confirmation required for this mutation; re-run with --yes'

# Gate passes with --apply --yes; the user is deleted.
exec rancher delete user u-e2e --apply --yes

# Gone: get by name returns NOT_FOUND with the curated message and list hint.
! exec rancher get user u-e2e -o json
jsonquery stderr data.error.code NOT_FOUND
jsonquery stderr data.error.message 'user not found: u-e2e'
jsonquery stderr data.error.hint 'list with: rancher get users'

-- user.yaml --
apiVersion: management.cattle.io/v3
kind: User
metadata:
  name: u-e2e
displayName: e2euser
username: e2euser
principalIds:
  - local://u-e2e
