env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN

seedobj core/v1/namespaces . namespace.yaml
seedobj catalog.cattle.io/v1/clusterrepos . repo.yaml

# --dry-run reads the server and sends no action: the preview is from server
# reads, the version is the one `rancher charts` shows, and the values from a
# file appear by path, never by content. The values the command adds, the ones
# the Rancher UI adds when it installs a chart, appear with their values; the
# facade's projects carry no System project label, so systemProjectId is "".
exec rancher app install app-install-rel --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-install-chart --values values.yaml --dry-run -o json
cp stdout dry.json
jsonquery dry.json data.previewSource serverReads
jsonquery dry.json data.action create
jsonquery dry.json data.displayName app-install-rel
jsonquery dry.json 'data.diff.#(path="version").to' 1.2.0
jsonquery dry.json 'data.diff.#(path="chart").to' app-install-chart
jsonquery dry.json 'data.diff.#(path="values.replicaCount").to' '<hidden>'
jsonquery dry.json 'data.diff.#(path="values.global.cattle.clusterId").to' c-test
jsonquery dry.json 'data.diff.#(path="values.global.cattle.clusterName").to' testcluster
jsonquery dry.json 'data.diff.#(path="values.global.cattle.url").to' https://rancher.e2e.example.test
jsonquery dry.json 'data.diff.#(path="values.global.cattle.systemProjectId").path' values.global.cattle.systemProjectId
jsonquery dry.json 'data.diff.#(path="values.global.cattle.systemProjectId").to' ''
jsonquery dry.json 'data.diff.#(path="values.global.cattle.rkePathPrefix").path' values.global.cattle.rkePathPrefix
jsonquery dry.json 'data.diff.#(path="values.global.cattle.rkeWindowsPathPrefix").path' values.global.cattle.rkeWindowsPathPrefix
jsonquery dry.json 'data.diff.#(path="values.global.cattle.windows.enabled").path' ''
jsonquery dry.json 'data.diff.#(path="values.global.cattle.systemDefaultRegistry").path' ''
jsonquery dry.json 'warnings.#(%"rancher-cli adds the values the Rancher UI adds when it installs a chart: *")' 'rancher-cli adds the values the Rancher UI adds when it installs a chart: values.global.cattle.clusterId, values.global.cattle.clusterName, values.global.cattle.rkePathPrefix, values.global.cattle.rkeWindowsPathPrefix, values.global.cattle.systemProjectId, values.global.cattle.url'
! stdout 'topsecret'
appactions actions.json
jsonquery actions.json '#' 0

# Without --apply the command is refused and sends nothing.
! exec rancher app install app-install-rel --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-install-chart -o json
jsonquery stderr data.error.code CONFIRMATION_REQUIRED
appactions actions.json
jsonquery actions.json '#' 0

# --apply sends the install action once, with the chart, release, version and
# values and the request id the command reports.
exec rancher app install app-install-rel --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-install-chart --version 1.1.0 --values values.yaml --helm-timeout 5m --description 'first install' --apply -o json
cp stdout apply.json
jsonquery apply.json data.release app-install-rel
jsonquery apply.json data.operationNamespace app-install-ns
! jsonquery apply.json data.operationName ''
jsonget apply.json data.operationName opname.txt
setenvfrom OPNAME opname.txt
jsonget apply.json data.requestID reqid.txt
setenvfrom REQID reqid.txt
! stdout 'topsecret'
appactions actions.json
jsonquery actions.json '#' 1
jsonquery actions.json '0.action' install
jsonquery actions.json '0.fieldManager' cli.rancher.io
jsonquery actions.json '0.path' /k8s/clusters/c-test/v1/catalog.cattle.io.clusterrepos/app-install-repo
jsonquery actions.json '0.body.namespace' app-install-ns
jsonquery actions.json '0.body.wait' true
jsonquery actions.json '0.body.timeout' 5m0s
jsonquery actions.json '0.body.charts.#' 1
jsonquery actions.json '0.body.charts.0.chartName' app-install-chart
jsonquery actions.json '0.body.charts.0.releaseName' app-install-rel
jsonquery actions.json '0.body.charts.0.version' 1.1.0
jsonquery actions.json '0.body.charts.0.description' 'first install'
jsonquery actions.json '0.body.charts.0.values.replicaCount' 3
jsonquery actions.json '0.body.charts.0.values.image.tag' topsecret-tag
jsonquery actions.json '0.body.charts.0.values.global.cattle.clusterId' c-test
jsonquery actions.json '0.body.charts.0.values.global.cattle.clusterName' testcluster
jsonquery actions.json '0.body.charts.0.values.global.cattle.url' https://rancher.e2e.example.test
jsonquery actions.json '0.body.charts.0.values.global.cattle.rkePathPrefix' ''
jsonquery actions.json '0.body.charts.0.values.global.cattle.rkeWindowsPathPrefix' ''
jsonquery actions.json '0.body.charts.0.values.global.cattle.systemProjectId' ''
jsonquery actions.json '0.body.charts.0.values.global.cattle.@keys' '["clusterId","clusterName","rkePathPrefix","rkeWindowsPathPrefix","systemProjectId","url"]'
jsonquery actions.json '0.body.charts.0.annotations.cli\.rancher\.io/request-id' $REQID
jsonquery actions.json '0.body.charts.0.annotations.catalog\.cattle\.io/ui-source-repo' app-install-repo
jsonquery actions.json '0.body.charts.0.annotations.catalog\.cattle\.io/ui-source-repo-type' cluster

# The operation Rancher created exists in the release namespace.
exec rancher get operation $OPNAME --cluster testcluster --namespace app-install-ns -o json
jsonquery stdout data.status.action install
jsonquery stdout data.status.releaseName app-install-rel

# While that operation may still run, another install of the release is
# refused and sends nothing.
! exec rancher app install app-install-rel --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-install-chart --apply -o json
jsonquery stderr data.error.code CONFLICT
appactions actions.json
jsonquery actions.json '#' 1

# Rancher records the release as an App; the operation finishes.
seedobj catalog.cattle.io/v1/apps app-install-ns app.yaml
flipstatus testcluster catalog.cattle.io/v1/operations app-install-ns $OPNAME '{"observedGeneration":1,"conditions":[{"type":"Reconciling","status":"False"}]}'

# The release exists now: install refuses it.
! exec rancher app install app-install-rel --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-install-chart --apply -o json
jsonquery stderr data.error.code CONFLICT

# uninstall: --dry-run previews from the App and sends nothing.
exec rancher app uninstall app-install-rel --cluster testcluster --namespace app-install-ns --keep-history --no-hooks --dry-run -o json
cp stdout undry.json
jsonquery undry.json data.previewSource serverReads
jsonquery undry.json data.action delete
jsonquery undry.json data.displayName app-install-rel
jsonquery undry.json 'data.diff.#(path="chart").from' app-install-chart
jsonquery undry.json 'data.diff.#(path="keepHistory").to' true
appactions actions.json
jsonquery actions.json '#' 1

# --apply without --yes is refused: uninstall removes the release's resources.
! exec rancher app uninstall app-install-rel --cluster testcluster --namespace app-install-ns --keep-history --no-hooks --apply -o json
jsonquery stderr data.error.code CONFIRMATION_REQUIRED
appactions actions.json
jsonquery actions.json '#' 1

# --apply --yes sends the uninstall action once.
exec rancher app uninstall app-install-rel --cluster testcluster --namespace app-install-ns --keep-history --no-hooks --apply --yes -o json
cp stdout unapply.json
jsonquery unapply.json data.release app-install-rel
jsonquery unapply.json data.operationNamespace app-install-ns
! jsonquery unapply.json data.operationName ''
jsonget unapply.json data.operationName unopname.txt
setenvfrom UNOPNAME unopname.txt
! jsonquery unapply.json data.operationName $OPNAME
appactions actions.json
jsonquery actions.json '#' 2
jsonquery actions.json '1.action' uninstall
jsonquery actions.json '1.fieldManager' cli.rancher.io
jsonquery actions.json '1.path' /k8s/clusters/c-test/v1/catalog.cattle.io.apps/app-install-ns/app-install-rel
jsonquery actions.json '1.body.keepHistory' true
jsonquery actions.json '1.body.noHooks' true
jsonquery actions.json '1.body.dryRun' ''
exec rancher get operation $UNOPNAME --cluster testcluster --namespace app-install-ns -o json
jsonquery stdout data.status.action uninstall
jsonquery stdout data.status.releaseName app-install-rel

# A chart whose default values declare both registry paths gets both set to
# one value: the system-default-registry Setting has no value, so its default.
exec rancher app install app-install-reg --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-registry-chart --dry-run -o json
cp stdout regdry.json
jsonquery regdry.json 'data.diff.#(path="values.global.systemDefaultRegistry").to' setting-registry.e2e.example.test
jsonquery regdry.json 'data.diff.#(path="values.global.cattle.systemDefaultRegistry").to' setting-registry.e2e.example.test

# --no-system-default-registry sends neither.
exec rancher app install app-install-reg --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-registry-chart --no-system-default-registry --dry-run -o json
cp stdout noregdry.json
jsonquery noregdry.json 'data.diff.#(path="values.global.systemDefaultRegistry").path' ''
jsonquery noregdry.json 'data.diff.#(path="values.global.cattle.systemDefaultRegistry").path' ''
jsonquery noregdry.json 'data.diff.#(path="values.global.cattle.clusterId").to' c-test
appactions actions.json
jsonquery actions.json '#' 2

# --system-default-registry sends the host at both paths.
exec rancher app install app-install-reg --cluster testcluster --namespace app-install-ns --repo app-install-repo --chart app-registry-chart --system-default-registry registry.e2e.example.test --apply -o json
appactions actions.json
jsonquery actions.json '#' 3
jsonquery actions.json '2.body.charts.0.chartName' app-registry-chart
jsonquery actions.json '2.body.charts.0.values.global.systemDefaultRegistry' registry.e2e.example.test
jsonquery actions.json '2.body.charts.0.values.global.cattle.systemDefaultRegistry' registry.e2e.example.test
jsonquery actions.json '2.body.charts.0.values.global.cattle.clusterId' c-test

-- namespace.yaml --
apiVersion: v1
kind: Namespace
metadata:
  name: app-install-ns
-- repo.yaml --
apiVersion: catalog.cattle.io/v1
kind: ClusterRepo
metadata:
  name: app-install-repo
spec:
  url: https://charts.example.test/app-install
  enabled: true
-- values.yaml --
replicaCount: 3
image:
  tag: topsecret-tag
-- app.yaml --
apiVersion: catalog.cattle.io/v1
kind: App
metadata:
  name: app-install-rel
  namespace: app-install-ns
spec:
  name: app-install-rel
  chart:
    metadata:
      name: app-install-chart
      version: 1.1.0
      annotations:
        catalog.cattle.io/ui-source-repo-type: cluster
        catalog.cattle.io/ui-source-repo: app-install-repo
  info:
    status: deployed
