# The full kubectl round trip COLD,
# hermetic: no seedexeccache, no warm cache. `rancher kubeconfig` embeds
# the stored login CA directly into the exec plugin's own --cacert flag
# (kubeconfig.go), so the exec plugin's first credential request creates
# its token through the facade with no prior state at all.
[!kubectl] skip 'kubectl not on PATH'

stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin

exec rancher kubeconfig --cluster testcluster
cp stdout kc.yaml

exec kubectl --kubeconfig kc.yaml get namespaces
stdout default

-- token.txt --
e2e:secret
