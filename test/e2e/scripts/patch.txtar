env RANCHER_CLI_URL=$TEST_RANCHER_URL
env RANCHER_CLI_TOKEN=$TEST_RANCHER_TOKEN
env PATCH='[{"op":"replace","path":"/data/key","value":"new"}]'

exec rancher create resource -f cm.yaml --cluster testcluster --apply

# dry-run Effect carries the per-field diff
exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch $PATCH --dry-run -o json
cp stdout eff.json
jsonquery eff.json data.diff.0.path /data/key
jsonquery eff.json data.diff.0.from old
jsonquery eff.json data.diff.0.to new

exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch $PATCH --apply -o json

exec rancher get configmap patch-cm --cluster testcluster --namespace default -o json
jsonquery stdout data.data.key new

env LABEL_PATCH='[{"op":"add","path":"/metadata/labels/app.kubernetes.io~1name","value":"web"}]'

# a domain-prefixed label escapes as one RFC 6901 segment; text and JSON agree
exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch $LABEL_PATCH --dry-run -o json
cp stdout label-eff.json
jsonquery label-eff.json data.diff.0.path /metadata/labels/app.kubernetes.io~1name
jsonquery label-eff.json data.diff.0.to web

exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch $LABEL_PATCH --dry-run
stdout '  /metadata/labels/app\.kubernetes\.io~1name: <nil> -> web'

# -p is --patch, as in kubectl
exec rancher patch configmap patch-cm --cluster testcluster --namespace default -p $LABEL_PATCH --dry-run -o json
jsonquery stdout data.diff.0.to web

# --patch-file reads the ops from a file, or from stdin for -
exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch-file ops.json --dry-run -o json
jsonquery stdout data.diff.0.path /data/key
jsonquery stdout data.diff.0.to fromfile
stdin ops.json
exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch-file - --dry-run -o json
jsonquery stdout data.diff.0.to fromfile

# exactly one of --patch/--patch-file, not both and not neither
! exec rancher patch configmap patch-cm --cluster testcluster --namespace default --patch $PATCH --patch-file ops.json -o json
jsonquery stderr data.error.code VALIDATION
jsonquery stderr data.error.message 'provide exactly one of --patch or --patch-file, not both'
! exec rancher patch configmap patch-cm --cluster testcluster --namespace default -o json
jsonquery stderr data.error.message 'a patch is required: pass --patch or --patch-file'

# --type merge applies an RFC 7386 merge patch; an object without it names the flag
exec rancher patch configmap patch-cm --cluster testcluster --namespace default --type merge -p '{"data":{"key":"merged"}}' --dry-run -o json
jsonquery stdout data.diff.0.path /data/key
jsonquery stdout data.diff.0.to merged
! exec rancher patch configmap patch-cm --cluster testcluster --namespace default -p '{"data":{"key":"merged"}}' -o json
jsonquery stderr data.error.code VALIDATION
jsonquery stderr data.error.message 'invalid patch: a JSON object is a merge patch; pass --type merge, or give RFC 6902 operations as a JSON array'

# -f is not a patch flag: kubectl's -f names the object, not the patch
! exec rancher patch configmap patch-cm --cluster testcluster --namespace default -f ops.json -o json
jsonquery stderr data.error.code VALIDATION
stderr 'unknown flag at word 8 after rancher'

env SECRET_PATCH='[{"op":"replace","path":"/data/password","value":"bmV3"}]'

exec rancher create resource -f secret.yaml --cluster testcluster --apply --yes

# secret diffs are redacted: path stays, raw values never appear
exec rancher patch secret patch-secret --cluster testcluster --namespace default --patch $SECRET_PATCH --dry-run -o json
cp stdout secret-eff.json
jsonquery secret-eff.json data.diff.0.path /data/password
jsonquery secret-eff.json data.diff.0.from '<redacted>'
jsonquery secret-eff.json data.diff.0.to '<redacted>'
! stdout b2xk
! stdout bmV3

# secret is now a Sensitive kind: patch --apply alone is refused
! exec rancher patch secret patch-secret --cluster testcluster --namespace default --patch $SECRET_PATCH --apply
stderr 'error \(CONFIRMATION_REQUIRED\):'
stderr 're-run with --yes'

exec rancher patch secret patch-secret --cluster testcluster --namespace default --patch $SECRET_PATCH --apply --yes -o json

exec rancher get secret patch-secret --cluster testcluster --namespace default -o json
jsonquery stdout data.data.password bmV3

-- ops.json --
[{"op":"replace","path":"/data/key","value":"fromfile"}]
-- cm.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: patch-cm
  namespace: default
  labels:
    team: platform
data:
  key: old
-- secret.yaml --
apiVersion: v1
kind: Secret
metadata:
  name: patch-secret
  namespace: default
data:
  password: b2xk
