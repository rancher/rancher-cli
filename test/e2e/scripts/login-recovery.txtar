# Recovery after a lost derived token create response, executed end to end:
# the first login fails with an unknown derived token; the emitted procedure
# (re-login, list, delete the token whose description carries the marker)
# removes exactly that token. Prompts need a real pty; see
# auth-login-local.txtar.
[!unix] skip 'ttyin (real pty) is unix-only'

ttyin -stdin creds.txt
! exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider localProvider -o json
jsonquery stderr data.error.details.derivedToken.outcome unknown
jsonget stderr data.error.details.operationMarker marker.txt
setenvfrom MARKER marker.txt

ttyin -stdin creds.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --auth-provider localProvider

exec rancher get tokens -o json
jsonget stdout 'data.#(spec.description%"*[op:'$MARKER']*").metadata.name' leftover.txt
setenvfrom LEFTOVER leftover.txt
exec rancher delete token $LEFTOVER --apply --yes

exec rancher get tokens -o json
jsonquery stdout 'data.#(spec.description%"*[op:'$MARKER']*").metadata.name' ''

-- creds.txt --
e2e-user
e2e-pass
