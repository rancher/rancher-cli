# config-flow: never sets RANCHER_CLI_URL/RANCHER_CLI_TOKEN - the point is to prove
# the STORED token, not an env override, drives auth.

stdin token.txt
exec rancher auth login e2e --url $TEST_RANCHER_URL --cacert $TEST_RANCHER_CACERT --token-stdin
exists $RANCHER_CLI_CONFIG_DIR/config.yaml

exec rancher auth status -o json
jsonquery stdout data.ok true
jsonquery stdout data.server e2e

exec rancher auth status
stdout 'AUTH STATUS'
stdout 'ok: true'
stdout 'server: e2e'

# logout deletes the matching exec-credential cache entry alongside the login token
seedexeccache e2e-c-test c-test
exec rancher auth logout e2e -o json
jsonquery stdout 'data.deletedCache.#' 1

# --no-verify stores a pasted token against an unreachable server with no
# authenticated round-trip; a verified login (above) would have refused
# instead.
stdin noverify-token.txt
exec rancher auth login e2e-noverify --url https://127.0.0.1:1 --token-stdin --no-verify
stdout 'token stored for e2e-noverify \(https://127.0.0.1:1\) - not verified'
grep e2e-noverify $RANCHER_CLI_CONFIG_DIR/config.yaml

# a URL with an @ after the host is refused before anything is saved or sent.
stdin rawat-token.txt
! exec rancher auth login e2e-rawat --url https://admin:1234/x@h --token-stdin -o json
jsonquery stderr data.error.code VALIDATION
stderr 'it holds an @ after the host'
! stderr 'x@h'
! grep e2e-rawat $RANCHER_CLI_CONFIG_DIR/config.yaml

-- token.txt --
e2e:secret
-- noverify-token.txt --
noverify:secret
-- rawat-token.txt --
rawat:secret
